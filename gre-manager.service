[Unit]
Description=RIZAY Tunnel Manager - GRE engine
Wants=network-online.target
After=network-online.target
ConditionPathExists=/etc/gre-manager/config.conf

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/bin/gre-manager start-gre
ExecStop=/usr/local/bin/gre-manager stop-gre
Restart=on-failure
RestartSec=5s
TimeoutStartSec=45s
TimeoutStopSec=30s
UMask=0077
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
LockPersonality=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target

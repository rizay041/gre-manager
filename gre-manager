ping_stats() {
  local target=$1 samples=$2 output timing
  output=$(LC_ALL=C ping -n -q -c "$samples" -i 0.2 -W 2 "$target" 2>&1 || true)
  PING_LOSS=$(printf '%s\n' "$output" | sed -n 's/.* \([0-9.]*\)% packet loss.*/\1/p' | head -n 1)
  [[ $PING_LOSS =~ ^[0-9]+([.][0-9]+)?$ ]] || PING_LOSS="100"
  timing=$(printf '%s\n' "$output" | awk -F' = ' '/^(rtt|round-trip)/ { split($2,a,"/"); sub(/ .*/,"",a[4]); print a[1],a[2],a[3],a[4]; exit }')
  PING_MIN="-"; PING_AVG="-"; PING_MAX="-"; PING_MDEV="-"
  [[ -z $timing ]] || read -r PING_MIN PING_AVG PING_MAX PING_MDEV <<< "$timing"
}

health() {
  require_root health
  load_config || die "not configured; run: sudo gre-manager wizard"
  require_command ping
  local samples=${1:-50} service_port=${2:-} public_loss public_min public_avg public_max public_jitter
  local gre_loss=100 gre_min="-" gre_avg="-" gre_max="-" gre_jitter="-" tunnel_up=0 forward_on=0 score label
  local tunnel_text="DISABLED" forward_text="OFF" tcp_text="NOT TESTED" gost_text="NOT CONFIGURED" probe_target
  local private_loss=100 private_min="-" private_avg="-" private_max="-" private_jitter="-" private_text="DISABLED" path_loss
  valid_samples "$samples" || die "sample count must be between 5 and 200"
  [[ -z $service_port ]] || valid_port "$service_port" || die "service port must be 1-65535"
  banner
  info "Measuring both paths with $samples packets each; please wait..."
  ping_stats "$REMOTE_IP" "$samples"
  public_loss=${PING_LOSS%.*}; public_min=$PING_MIN; public_avg=$PING_AVG; public_max=$PING_MAX; public_jitter=$PING_MDEV
  if [[ $MODE != gost ]]; then
    tunnel_text="DOWN"
    if ip link show "$IFACE" 2>/dev/null | grep -q 'UP'; then tunnel_up=1; tunnel_text="UP"; fi
    ping_stats "$GRE_REMOTE" "$samples"
    gre_loss=${PING_LOSS%.*}; gre_min=$PING_MIN; gre_avg=$PING_AVG; gre_max=$PING_MAX; gre_jitter=$PING_MDEV
  fi
  if [[ $PRIVATE_ENABLED == yes ]]; then
    private_text="DOWN"
    if ip link show "$PRIVATE_IFACE" >/dev/null 2>&1; then private_text="UP"; fi
    ping_stats "$PRIVATE_REMOTE" "$samples"
    private_loss=${PING_LOSS%.*}; private_min=$PING_MIN; private_avg=$PING_AVG; private_max=$PING_MAX; private_jitter=$PING_MDEV
  fi
  if [[ $(sysctl -n net.ipv4.ip_forward 2>/dev/null || true) == 1 ]]; then forward_on=1; forward_text="ON"; fi
  if [[ $ROLE == iran && -s $GOST_RULES_FILE ]]; then
    if systemctl is-active --quiet "$GOST_SERVICE" 2>/dev/null; then gost_text="ACTIVE"; else gost_text="DOWN"; fi
  elif [[ $ROLE == kharej && $PRIVATE_ENABLED == yes ]]; then
    if systemctl is-active --quiet "$GOST_SERVICE" 2>/dev/null; then gost_text="PRIVATE RELAY ACTIVE"; else gost_text="PRIVATE RELAY DOWN"; fi
  fi
  if [[ -n $service_port ]]; then
    require_command timeout
    probe_target=$GRE_REMOTE
    [[ $MODE != gost ]] || probe_target=$REMOTE_IP
    if [[ $ROLE == iran && -s $GOST_RULES_FILE ]]; then
      local transport
      transport=$(awk -v port="$service_port" '$1 == "tcp" && $3 == port { print $4; exit }' "$GOST_RULES_FILE")
      case "$transport" in private|public) probe_target=$KHAREJ_IP ;; esac
    fi
    # The variables below are positional parameters inside the child Bash process.
    # shellcheck disable=SC2016
    if timeout 3 bash -c 'exec 3<>/dev/tcp/$1/$2' _ "$probe_target" "$service_port" 2>/dev/null; then
      tcp_text="OPEN ($probe_target:$service_port)"
    else
      tcp_text="CLOSED/FILTERED ($probe_target:$service_port)"
    fi
  fi

  path_loss=$gre_loss
  if [[ $ROLE == iran && -s $GOST_RULES_FILE ]] && awk '$4 == "private" { found=1 } END { exit !found }' "$GOST_RULES_FILE"; then path_loss=$private_loss; fi
  if [[ $tcp_text == OPEN* ]]; then
    score=100
  elif [[ $MODE == gost ]]; then
    score=$((100 - public_loss))
    [[ $ROLE != iran || $gost_text == ACTIVE || ! -s $GOST_RULES_FILE ]] || score=$((score - 35))
  elif (( path_loss < 100 )); then
    score=$((100 - (path_loss * 80 / 100)))
  else
    score=$((50 - (public_loss * 30 / 100)))
    (( tunnel_up == 1 )) || score=$((score - 20))
  fi
  [[ $MODE == gost ]] || (( forward_on == 1 )) || score=$((score - 10))
  (( score < 0 )) && score=0
  (( score > 100 )) && score=100
  if (( score >= 90 )); then label="Excellent"; elif (( score >= 70 )); then label="Good"; elif (( score >= 45 )); then label="Unstable"; else label="Not ready"; fi

  printf '\nRole / Mode           : %s / %s\n' "${ROLE^^}" "${MODE^^}"
  printf 'IRAN public IP        : %s\n' "$IRAN_IP"
  printf 'KHAREJ public IP      : %s\n' "$KHAREJ_IP"
  printf 'Public path loss      : %s%%  (RTT min/avg/max/jitter: %s/%s/%s/%s ms)\n' "$public_loss" "$public_min" "$public_avg" "$public_max" "$public_jitter"
  printf 'GRE path loss         : %s%%  (RTT min/avg/max/jitter: %s/%s/%s/%s ms)\n' "$gre_loss" "$gre_min" "$gre_avg" "$gre_max" "$gre_jitter"
  if [[ $PRIVATE_ENABLED == yes ]]; then
    printf 'PRIVATE IPv6 loss     : %s%%  (RTT min/avg/max/jitter: %s/%s/%s/%s ms)\n' "$private_loss" "$private_min" "$private_avg" "$private_max" "$private_jitter"
    printf 'PRIVATE IPv6 peer     : %s | interface: %s\n' "$PRIVATE_REMOTE" "$private_text"
    if (( private_loss == 100 )); then info "PRIVATE IPv6 has no replies. Configure BOTH servers; allow IP Protocol 41 and ICMPv6."; fi
  fi
  printf 'GRE interface         : %s\n' "$tunnel_text"
  printf 'GOST service          : %s\n' "$gost_text"
  printf 'IPv4 forwarding       : %s\n' "$forward_text"
  printf 'TCP service probe     : %s\n' "$tcp_text"
  printf '\nEstimated readiness   : %s%% - %s\n' "$score" "$label"
  printf 'Note: this is a diagnostic score, not a guaranteed statistical probability.\n'
  printf 'Run this test on BOTH servers for a true two-sided comparison.\n'
  (( score >= 45 ))
}

status() {
  require_root status
  load_config || die "not configured; run: sudo gre-manager wizard"
  local output_mode=${1:-} state="DOWN" forwarding="false" rules_count=0 gost_rules=0 gost_state="NOT_CONFIGURED"
  local private_state="DISABLED"
  if [[ $PRIVATE_ENABLED == yes ]]; then
    private_state="DOWN"
    if ip link show "$PRIVATE_IFACE" >/dev/null 2>&1; then private_state="UP"; fi
  fi
  [[ $MODE != gost ]] || state="DISABLED"
  if ip link show "$IFACE" >/dev/null 2>&1; then state="UP"; fi
  if [[ $(sysctl -n net.ipv4.ip_forward 2>/dev/null || true) == 1 ]]; then forwarding="true"; fi
  if [[ -s $RULES_FILE ]]; then rules_count=$(awk '!/^($|#)/ { count++ } END { print count+0 }' "$RULES_FILE"); fi
  if [[ -s $GOST_RULES_FILE ]]; then gost_rules=$(awk '!/^($|#)/ { count++ } END { print count+0 }' "$GOST_RULES_FILE"); fi
  if systemctl is-active --quiet "$GOST_SERVICE" 2>/dev/null; then gost_state="ACTIVE";
  elif (( gost_rules > 0 )) || [[ $ROLE == kharej && $PRIVATE_ENABLED == yes ]]; then gost_state="DOWN"; fi
  if [[ $output_mode == --json ]]; then
    printf '{"version":"%s","role":"%s","mode":"%s","iran_ip":"%s","kharej_ip":"%s","gre_local":"%s","gre_remote":"%s","gre":"%s","gost":"%s","gost_version":"%s","private_ipv6":"%s","private_local":"%s","private_remote":"%s","ip_forward":%s,"gre_rules":%s,"gost_rules":%s}\n' \
      "$VERSION" "${ROLE^^}" "${MODE^^}" "$IRAN_IP" "$KHAREJ_IP" "$GRE_LOCAL" "$GRE_REMOTE" "$state" "$gost_state" "$GOST_VERSION" "$private_state" "$PRIVATE_LOCAL" "$PRIVATE_REMOTE" "$forwarding" "$rules_count" "$gost_rules"
    [[ $state == UP || $state == DISABLED ]] && [[ $gost_state != DOWN && $private_state != DOWN ]]
    return
  fi
  banner
  printf 'Role: %s | Mode: %s | IRAN: %s | KHAREJ: %s\n' "${ROLE^^}" "${MODE^^}" "$IRAN_IP" "$KHAREJ_IP"
  printf 'GRE: %s | GOST: %s | GRE rules: %s | GOST rules: %s\n' "$state" "$gost_state" "$rules_count" "$gost_rules"
  printf 'PRIVATE IPv6: %s | Local: %s | Peer: %s | GOST version: %s\n' "$private_state" "$PRIVATE_LOCAL" "$PRIVATE_REMOTE" "$GOST_VERSION"
  if [[ $state == UP ]]; then
    ip -brief address show "$IFACE"
    printf 'IPv4 forwarding: %s\n' "${forwarding^^}"
  elif [[ $state == DISABLED ]]; then
    info "GRE tunnel: disabled by GOST mode"
  else
    info "GRE tunnel: stopped"
    return 1
  fi
}

optimize_network() {
  require_root optimize
  local bbr=0 tmp
  ui_confirm "RIZAY - Network optimizer" "Apply FQ, TCP MTU probing, keepalive and BBR (when supported)?" || return 0
  acquire_lock
  modprobe tcp_bbr >/dev/null 2>&1 || true
  if sysctl -n net.ipv4.tcp_available_congestion_control 2>/dev/null | grep -qw bbr; then bbr=1; fi
  tmp=$(mktemp /etc/sysctl.d/99-rizay-tunnel.XXXXXX)
  cat > "$tmp" <<'EOF'
# Managed by RIZAY Tunnel Manager
net.ipv4.ip_forward = 1
net.core.default_qdisc = fq
net.ipv4.tcp_mtu_probing = 1
net.ipv4.tcp_keepalive_time = 600
EOF
  if (( bbr == 1 )); then printf 'net.ipv4.tcp_congestion_control = bbr\n' >> "$tmp"; fi
  chmod 644 "$tmp"
  mv -f "$tmp" "$OPTIMIZE_FILE"
  sysctl -p "$OPTIMIZE_FILE"
  if (( bbr == 1 )); then info "Safe optimization applied with BBR."; else info "Safe optimization applied; BBR is not supported by this kernel."; fi
}

restore_network_defaults() {
  require_root restore-network
  if [[ ! -f $OPTIMIZE_FILE ]]; then info "RIZAY optimization is not installed."; return 0; fi
  ui_confirm "RIZAY - Restore network defaults" "Remove the RIZAY sysctl profile? Distribution defaults will return after reboot." || return 0
  rm -f -- "$OPTIMIZE_FILE"
  info "RIZAY sysctl profile removed. Reboot to restore distribution defaults."
}


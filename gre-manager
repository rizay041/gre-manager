valid_ipv4() {
  local ip=$1 IFS=. octets i
  [[ $ip =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ ]] || return 1
  read -r -a octets <<< "$ip"
  for i in "${octets[@]}"; do
    [[ $i =~ ^[0-9]{1,3}$ ]] && (( 10#$i <= 255 )) || return 1
  done
}

valid_port() { [[ $1 =~ ^[0-9]{1,5}$ ]] && (( 10#$1 >= 1 && 10#$1 <= 65535 )); }
valid_mtu() { [[ $1 =~ ^[0-9]+$ ]] && (( 10#$1 >= 576 && 10#$1 <= 9000 )); }
valid_protocol() { [[ $1 == tcp || $1 == udp ]]; }
valid_mode() { [[ $1 == hybrid || $1 == gre || $1 == gost ]]; }
valid_transport() { [[ $1 == public || $1 == gre || $1 == private ]]; }
valid_private_count() { [[ $1 =~ ^[0-9]{1,2}$ ]] && (( 10#$1 >= 1 && 10#$1 <= 15 )); }
valid_samples() { [[ $1 =~ ^[0-9]+$ ]] && (( 10#$1 >= 5 && 10#$1 <= 200 )); }

parse_port_list() {
  local input=$1 token port normalized=""
  local -a tokens=() parsed=()
  local -A seen=()
  PORT_LIST=""; PARSED_PORTS=(); PORT_LIST_ERROR=""
  if (( ${#input} > 8192 )) || [[ ! $input =~ ^[[:space:]]*[0-9]+[[:space:]]*(,[[:space:]]*[0-9]+[[:space:]]*)*$ ]]; then
    PORT_LIST_ERROR="Enter ports separated by commas. Example: 443,8443,2053"
    return 1
  fi
  IFS=',' read -r -a tokens <<< "$input"
  if (( ${#tokens[@]} > 1000 )); then
    PORT_LIST_ERROR="Enter at most 1000 ports at a time."
    return 1
  fi
  for token in "${tokens[@]}"; do
    token=${token//[[:space:]]/}
    if ! valid_port "$token"; then
      PORT_LIST_ERROR="Invalid port: $token. Every port must be between 1 and 65535."
      return 1
    fi
    port=$((10#$token))
    if [[ -n ${seen[$port]:-} ]]; then
      PORT_LIST_ERROR="Port $port is repeated. Enter each port once."
      return 1
    fi
    seen[$port]=1
    parsed+=("$port")
    normalized+="${normalized:+,}$port"
  done
  PORT_LIST=$normalized
  PARSED_PORTS=("${parsed[@]}")
}

prepare_port_batch() {
  local protocol=$1 sources=$2 destinations=${3:-$2}
  BATCH_SOURCES=(); BATCH_DESTINATIONS=(); BATCH_PROTOCOLS=(); BATCH_ERROR=""
  case "$protocol" in
    tcp|udp) BATCH_PROTOCOLS=("$protocol") ;;
    both) BATCH_PROTOCOLS=(tcp udp) ;;
    *) BATCH_ERROR="Choose TCP, UDP or TCP + UDP."; return 1 ;;
  esac
  if ! parse_port_list "$sources"; then BATCH_ERROR=$PORT_LIST_ERROR; return 1; fi
  BATCH_SOURCES=("${PARSED_PORTS[@]}")
  if ! parse_port_list "$destinations"; then BATCH_ERROR=$PORT_LIST_ERROR; return 1; fi
  BATCH_DESTINATIONS=("${PARSED_PORTS[@]}")
  if (( ${#BATCH_SOURCES[@]} != ${#BATCH_DESTINATIONS[@]} )); then
    BATCH_ERROR="IRAN and KHAREJ must have the same number of ports, in matching order."
    return 1
  fi
}

derive_endpoints() {
  case "$ROLE" in
    iran)
      LOCAL_IP=$IRAN_IP
      REMOTE_IP=$KHAREJ_IP
      GRE_LOCAL="10.77.0.1"
      GRE_REMOTE="10.77.0.2"
      ;;
    kharej)
      LOCAL_IP=$KHAREJ_IP
      REMOTE_IP=$IRAN_IP
      GRE_LOCAL="10.77.0.2"
      GRE_REMOTE="10.77.0.1"
      ;;
    *) die "invalid server role; run: sudo gre-manager wizard" ;;
  esac
  PRIVATE_LOCAL=$(private_address "$ROLE" 1)
  if [[ $ROLE == iran ]]; then PRIVATE_REMOTE=$(private_address kharej 1);
  else PRIVATE_REMOTE=$(private_address iran 1); fi
}

private_address() {
  local role=$1 index=${2:-1} suffix host
  valid_private_count "$index" || die "private IPv6 pair count must be 1-15"
  case "$role" in iran) host=2 ;; kharej) host=1 ;; *) die "invalid private IPv6 role" ;; esac
  printf -v suffix '%x' "$((10#$index))"
  printf 'fd1d:fc98:b73e:b48%s::%s' "$suffix" "$host"
}

validate_config() {
  [[ $ROLE == iran || $ROLE == kharej ]] || die "role must be IRAN or KHAREJ"
  valid_mode "$MODE" || die "mode must be HYBRID, GRE or GOST"
  valid_ipv4 "$IRAN_IP" || die "invalid IRAN public IPv4 address"
  valid_ipv4 "$KHAREJ_IP" || die "invalid KHAREJ public IPv4 address"
  [[ $IRAN_IP != "$KHAREJ_IP" ]] || die "IRAN and KHAREJ IPs must be different"
  valid_mtu "$MTU" || die "MTU must be between 576 and 9000"
  [[ $PRIVATE_ENABLED == yes || $PRIVATE_ENABLED == no ]] || die "private IPv6 must be yes or no"
  valid_private_count "$PRIVATE_COUNT" || die "private IPv6 pair count must be 1-15"
  derive_endpoints
}

load_config() {
  [[ -r $CONFIG_FILE ]] || return 1
  local key value
  # Older releases have no private IPv6 fields.
  PRIVATE_ENABLED="no"; PRIVATE_COUNT="1"
  while IFS='=' read -r key value; do
    case "$key" in
      ROLE) ROLE=$value ;;
      MODE) MODE=$value ;;
      IRAN_IP) IRAN_IP=$value ;;
      KHAREJ_IP) KHAREJ_IP=$value ;;
      MTU) MTU=$value ;;
      PRIVATE_ENABLED) PRIVATE_ENABLED=$value ;;
      PRIVATE_COUNT) PRIVATE_COUNT=$value ;;
    esac
  done < "$CONFIG_FILE"
  validate_config
}

save_config() {
  if [[ -n ${1:-} ]]; then MODE=$1; fi
  validate_config
  acquire_lock
  install -d -m 700 "$CONFIG_DIR"
  local tmp
  tmp=$(mktemp "$CONFIG_DIR/config.XXXXXX")
  chmod 600 "$tmp"
  printf 'ROLE=%s\nMODE=%s\nIRAN_IP=%s\nKHAREJ_IP=%s\nMTU=%s\nPRIVATE_ENABLED=%s\nPRIVATE_COUNT=%s\n' \
    "$ROLE" "$MODE" "$IRAN_IP" "$KHAREJ_IP" "$MTU" "$PRIVATE_ENABLED" "$PRIVATE_COUNT" > "$tmp"
  mv -f "$tmp" "$CONFIG_FILE"
}

use_dialog() {
  [[ ${GRE_MANAGER_UI:-terminal} == dialog ]] && command -v whiptail >/dev/null 2>&1
}

ui_menu() {
  local title=$1 prompt=$2 choice tag label valid i
  shift 2
  local -a items=("$@")
  if use_dialog; then
    whiptail --title "$title" --menu "$prompt" 22 78 12 "${items[@]}" 3>&1 1>&2 2>&3
    return
  fi
  while true; do
    printf '\n%s\n%s\n\n' "$title" "$prompt" >&2
    for ((i=0; i<${#items[@]}; i+=2)); do
      tag=${items[$i]}; label=${items[$((i+1))]}
      printf '  %s) %s\n' "$tag" "$label" >&2
    done
    printf '\nYour choice: ' >&2
    read -r choice || return 1
    valid=0
    for ((i=0; i<${#items[@]}; i+=2)); do
      [[ $choice != "${items[$i]}" ]] || valid=1
    done
    if (( valid == 1 )); then printf '%s' "$choice"; return 0; fi
    printf 'Please choose one of the numbers shown above.\n' >&2
  done
}

ui_confirm() {
  local title=$1 message=$2 answer
  if use_dialog; then
    whiptail --title "$title" --yesno "$message" 20 78
    return
  fi
  printf '\n%s\n%s\n\n1) Confirm and apply\n0) Cancel\nYour choice: ' "$title" "$message" >&2
  read -r answer || return 1
  [[ $answer == 1 ]]
}

ui_input() {
  local title=$1 prompt=$2 default_value=${3:-} result
  if use_dialog; then
    result=$(whiptail --title "$title" --inputbox "$prompt" 10 72 "$default_value" 3>&1 1>&2 2>&3) || return 1
    printf '%s' "$result"
  else
    printf '\n%s\n%s [%s]: ' "$title" "$prompt" "$default_value" >&2
    read -r result || return 1
    printf '%s' "${result:-$default_value}"
  fi
}

ui_message() {
  local title=$1 message=$2
  if use_dialog; then
    whiptail --title "$title" --msgbox "$message" 14 76
  else
    printf '\n%s\n%s\n\n' "$title" "$message"
  fi
}

ui_ports() {
  local title=$1 prompt=$2 default_value=${3:-} input
  while true; do
    input=$(ui_input "$title" "$prompt" "$default_value") || return 1
    if parse_port_list "$input"; then return 0; fi
    ui_message "RIZAY - Check the ports" "$PORT_LIST_ERROR"
  done
}

ui_protocol() {
  local choice
  choice=$(ui_menu "RIZAY - Protocol" "Choose which traffic to forward:" \
    1 "TCP" 2 "UDP" 3 "TCP + UDP" 0 "Cancel") || return 1
  case "$choice" in 1) printf 'tcp' ;; 2) printf 'udp' ;; 3) printf 'both' ;; *) return 1 ;; esac
}

ui_engine() {
  local choice
  choice=$(ui_menu "RIZAY - Forwarding method" "For a simple setup, choose 1. Private IPv6 addresses are created automatically." \
    1 "GOST v2 + PRIVATE IPv6 (recommended)" \
    2 "GOST v2 inside GRE" 3 "GRE with iptables" \
    4 "GOST v2 via public IPv4" 0 "Cancel") || return 1
  case "$choice" in 1) printf 'gost-private' ;; 2) printf 'gost-gre' ;; 3) printf 'gre' ;; 4) printf 'gost-public' ;; *) return 1 ;; esac
}

wizard() {
  require_root wizard
  local selected_role=${1:-} role_choice ports="" protocol="tcp" engine="gost-private" summary next_step
  if [[ -r $CONFIG_FILE ]]; then load_config; fi
  clear 2>/dev/null || true
  banner
  if [[ -z $selected_role ]]; then
    role_choice=$(ui_menu "RIZAY - Step 1: Server" "Which server are you setting up?" \
      1 "IRAN - users connect to this server" \
      2 "KHAREJ - destination server" 0 "Cancel") || return 0
    case "$role_choice" in 1) selected_role=iran ;; 2) selected_role=kharej ;; *) return 0 ;; esac
  fi
  [[ $selected_role == iran || $selected_role == kharej ]] || die "server role must be iran or kharej"
  ROLE=$selected_role
  MODE="hybrid"
  PRIVATE_ENABLED="yes"
  while true; do
    IRAN_IP=$(ui_input "RIZAY - Step 2: IRAN IP" "Enter the public IPv4 of IRAN" "$IRAN_IP") || return 0
    valid_ipv4 "$IRAN_IP" && break
    ui_message "RIZAY - Check the IP" "Enter a valid IPv4. Example: 203.0.113.10"
  done
  while true; do
    KHAREJ_IP=$(ui_input "RIZAY - Step 3: KHAREJ IP" "Enter the public IPv4 of KHAREJ" "$KHAREJ_IP") || return 0
    if valid_ipv4 "$KHAREJ_IP" && [[ $KHAREJ_IP != "$IRAN_IP" ]]; then break; fi
    ui_message "RIZAY - Check the IP" "KHAREJ must be a valid IPv4 different from IRAN."
  done
  if [[ $ROLE == iran ]]; then
    ui_ports "RIZAY - Step 4: Ports" \
      "Enter ports separated by commas (example: 443,8443,2053). The same ports will be used on KHAREJ" "" || return 0
    ports=$PORT_LIST
    protocol=$(ui_protocol) || return 0
    engine=$(ui_engine) || return 0
    [[ $engine != gre ]] || MODE="gre"
  fi
  validate_config
  summary="Server: ${ROLE^^}
IRAN IP: $IRAN_IP
KHAREJ IP: $KHAREJ_IP
GRE: $GRE_LOCAL -> $GRE_REMOTE
PRIVATE IPv6: $PRIVATE_LOCAL -> $PRIVATE_REMOTE
GOST version: $GOST_VERSION
MTU: $MTU"
  if [[ $ROLE == iran ]]; then
    summary+="
Ports on IRAN and KHAREJ: $ports
Protocol: ${protocol^^}
Forwarding: ${engine^^}"
  else
    summary+="
Forwarding ports are selected on IRAN."
  fi
  summary+="
Existing rules on selected protocol/port pairs will be updated; other ports are kept."
  ui_confirm "RIZAY - Final step: Confirm installation" "$summary" || { info "Setup cancelled. No settings were changed."; return 0; }
  apply_setup "$engine" "$protocol" "$ports"
  if [[ $ROLE == kharej ]]; then next_step="Next: run the same installer on IRAN and choose option 1.";
  else next_step="If KHAREJ is not configured yet, run the installer there and choose option 2."; fi
  ui_message "RIZAY - Installation completed" "${ROLE^^} is configured. GRE and PRIVATE IPv6 are running.
${ports:+All selected ports were saved and activated: $ports}
$next_step
Private IPv6 needs IP Protocol 41 between the two servers.
Use option 5 to check whether the other server is reachable."
}

save_port_batch() {
  local engine=$1 protocol=$2 sources=$3 destinations=${4:-$3} transport=${5:-public}
  local file other_file pending tmp other_tmp proto i
  [[ $ROLE == iran ]] || die "forwarding ports are configured on IRAN"
  [[ $engine == gre || $engine == gost ]] || die "unknown forwarding engine"
  valid_transport "$transport" || die "path must be public, gre or private"
  prepare_port_batch "$protocol" "$sources" "$destinations" || die "$BATCH_ERROR"
  acquire_lock
  install -d -m 700 "$CONFIG_DIR"
  if [[ $engine == gost ]]; then file=$GOST_RULES_FILE; other_file=$RULES_FILE;
  else file=$RULES_FILE; other_file=$GOST_RULES_FILE; fi
  pending=$(mktemp "$CONFIG_DIR/batch.XXXXXX")
  tmp=$(mktemp "$CONFIG_DIR/rules.XXXXXX")
  other_tmp=$(mktemp "$CONFIG_DIR/rules.XXXXXX")
  for proto in "${BATCH_PROTOCOLS[@]}"; do
    for ((i=0; i<${#BATCH_SOURCES[@]}; i++)); do
      printf '%s %s %s' "$proto" "${BATCH_SOURCES[$i]}" "${BATCH_DESTINATIONS[$i]}" >> "$pending"
      if [[ $engine == gost ]]; then printf ' %s' "$transport" >> "$pending"; fi
      printf '\n' >> "$pending"
    done
  done
  if [[ -f $file ]]; then
    awk 'NR == FNR { selected[$1 SUBSEP $2]=1; next } !($1 SUBSEP $2 in selected)' "$pending" "$file" > "$tmp"
  fi
  cat "$pending" >> "$tmp"
  # A protocol/port pair can belong to only one engine; migrate the selected pairs.
  if [[ -f $other_file ]]; then
    awk 'NR == FNR { selected[$1 SUBSEP $2]=1; next } !($1 SUBSEP $2 in selected)' "$pending" "$other_file" > "$other_tmp"
  fi
  chmod 600 "$tmp" "$other_tmp"
  mv -f "$tmp" "$file"
  if [[ -f $other_file ]]; then mv -f "$other_tmp" "$other_file"; else rm -f -- "$other_tmp"; fi
  rm -f -- "$pending"
}

apply_setup() (
  set -Eeuo pipefail
  local engine=$1 protocol=$2 ports=$3 backup_dir
  if [[ $ROLE == iran ]]; then
    prepare_port_batch "$protocol" "$ports" "$ports" || die "$BATCH_ERROR"
  fi
  if [[ $ROLE == kharej || $engine == gost-* ]]; then install_gost_binary; fi
  acquire_lock
  install -d -m 700 "$CONFIG_DIR/backup"
  backup_dir=$(mktemp -d "$CONFIG_DIR/backup/setup.XXXXXX")
  for file in "$CONFIG_FILE" "$RULES_FILE" "$GOST_RULES_FILE" "$GOST_CONFIG_FILE" "$OLD_GOST_CONFIG_FILE"; do
    [[ ! -f $file ]] || cp -p -- "$file" "$backup_dir/"
  done
  save_config
  if [[ $ROLE == iran ]]; then
    case "$engine" in
      gost-public) save_port_batch gost "$protocol" "$ports" "$ports" public ;;
      gost-gre) save_port_batch gost "$protocol" "$ports" "$ports" gre ;;
      gost-private) save_port_batch gost "$protocol" "$ports" "$ports" private ;;
      gre) save_port_batch gre "$protocol" "$ports" "$ports" ;;
      *) die "unknown forwarding method" ;;
    esac
    if [[ -s $GOST_RULES_FILE ]]; then save_config hybrid; fi
  fi
  release_lock
  if [[ $ROLE == iran ]]; then systemctl stop "$GOST_SERVICE" >/dev/null 2>&1 || true; fi
  systemctl enable gre-manager.service >/dev/null
  systemctl restart gre-manager.service
  sync_private_service
  sync_gost
  release_lock
  info "Setup applied. Previous settings saved in: $backup_dir"
)

add_ports_wizard() {
  require_root add-ports
  load_config || die "choose 1) IRAN or 2) KHAREJ in the panel first"
  [[ $ROLE == iran ]] || { ui_message "RIZAY - Ports" "Port forwarding is configured on IRAN. KHAREJ runs the destination services."; return 0; }
  local engine=${1:-} protocol sources destinations transport="public"
  ui_ports "RIZAY - Add ports" "IRAN ports, separated by commas (example: 443,8443,2053)" "" || return 0
  sources=$PORT_LIST
  ui_ports "RIZAY - KHAREJ ports" "Press Enter to use the same ports, or enter a matching list in the same order" "$sources" || return 0
  destinations=$PORT_LIST
  protocol=$(ui_protocol) || return 0
  [[ -n $engine ]] || engine=$(ui_engine) || return 0
  [[ $engine != gost-public ]] || transport="public"
  [[ $engine != gost-gre ]] || transport="gre"
  [[ $engine != gost-private ]] || transport="private"
  prepare_port_batch "$protocol" "$sources" "$destinations" || { ui_message "RIZAY - Ports" "$BATCH_ERROR"; return 0; }
  ui_confirm "RIZAY - Confirm ports" "IRAN: $sources
KHAREJ: $destinations
Protocol: ${protocol^^}
Method: ${engine^^}
Existing rules on these protocol/port pairs will be updated; other ports are kept." || return 0
  (
    set -Eeuo pipefail
    if [[ $engine == gost-* ]]; then
      install_gost_binary
      if [[ $transport == private ]]; then enable_private_config; fi
      save_config hybrid
      save_port_batch gost "$protocol" "$sources" "$destinations" "$transport"
    else
      [[ $MODE != gost ]] || save_config hybrid
      save_port_batch gre "$protocol" "$sources" "$destinations"
    fi
    release_lock
    # Stop old GOST listeners before GRE claims migrated ports.
    systemctl stop "$GOST_SERVICE" >/dev/null 2>&1 || true
    systemctl enable gre-manager.service >/dev/null
    systemctl restart gre-manager.service
    sync_private_service
    sync_gost
    release_lock
  )
  ui_message "RIZAY - Ports ready" "All selected ports were saved and activated."
}

detect_public_iface() {
  PUBLIC_IFACE=$(ip -4 route get "$REMOTE_IP" 2>/dev/null | awk '{ for (i=1; i<NF; i++) if ($i == "dev") { print $(i+1); exit } }')
  [[ -n $PUBLIC_IFACE ]] || die "could not detect the public network interface"
}

remove_runtime_rules() {
  while ipt -t nat -C PREROUTING -j "$NAT_CHAIN" 2>/dev/null; do ipt -t nat -D PREROUTING -j "$NAT_CHAIN"; done
  while ipt -C FORWARD -j "$FWD_CHAIN" 2>/dev/null; do ipt -D FORWARD -j "$FWD_CHAIN"; done
  while ipt -t nat -C POSTROUTING -o "$IFACE" -j MASQUERADE 2>/dev/null; do
    ipt -t nat -D POSTROUTING -o "$IFACE" -j MASQUERADE
  done
  ipt -t nat -F "$NAT_CHAIN" 2>/dev/null || true
  ipt -F "$FWD_CHAIN" 2>/dev/null || true
  ipt -t nat -X "$NAT_CHAIN" 2>/dev/null || true
  ipt -X "$FWD_CHAIN" 2>/dev/null || true
}

ensure_runtime_chains() {
  [[ $ROLE == iran ]] || return 0
  [[ -n $PUBLIC_IFACE ]] || detect_public_iface
  ipt -t nat -N "$NAT_CHAIN" 2>/dev/null || true
  ipt -N "$FWD_CHAIN" 2>/dev/null || true
  ipt -t nat -C PREROUTING -j "$NAT_CHAIN" 2>/dev/null || ipt -t nat -A PREROUTING -j "$NAT_CHAIN"
  ipt -C FORWARD -j "$FWD_CHAIN" 2>/dev/null || ipt -A FORWARD -j "$FWD_CHAIN"
  ipt -t nat -C POSTROUTING -o "$IFACE" -j MASQUERADE 2>/dev/null || \
    ipt -t nat -A POSTROUTING -o "$IFACE" -j MASQUERADE
  ipt -C "$FWD_CHAIN" -i "$IFACE" -o "$PUBLIC_IFACE" -m conntrack \
    --ctstate ESTABLISHED,RELATED -j ACCEPT 2>/dev/null || \
    ipt -A "$FWD_CHAIN" -i "$IFACE" -o "$PUBLIC_IFACE" -m conntrack \
      --ctstate ESTABLISHED,RELATED -j ACCEPT
}

apply_rule() {
  local protocol=$1 source_port=$2 destination_port=$3
  [[ $ROLE == iran ]] || die "port forwarding must be configured on the IRAN gateway"
  valid_protocol "$protocol" || die "invalid protocol in rules file: $protocol"
  valid_port "$source_port" || die "invalid public port in rules file: $source_port"
  valid_port "$destination_port" || die "invalid KHAREJ port in rules file: $destination_port"
  ensure_runtime_chains
  ipt -t nat -C "$NAT_CHAIN" -i "$PUBLIC_IFACE" -p "$protocol" --dport "$source_port" \
    -j DNAT --to-destination "$GRE_REMOTE:$destination_port" 2>/dev/null || \
    ipt -t nat -A "$NAT_CHAIN" -i "$PUBLIC_IFACE" -p "$protocol" --dport "$source_port" \
      -j DNAT --to-destination "$GRE_REMOTE:$destination_port"
  ipt -C "$FWD_CHAIN" -i "$PUBLIC_IFACE" -o "$IFACE" -p "$protocol" \
    -d "$GRE_REMOTE" --dport "$destination_port" -j ACCEPT 2>/dev/null || \
    ipt -A "$FWD_CHAIN" -i "$PUBLIC_IFACE" -o "$IFACE" -p "$protocol" \
      -d "$GRE_REMOTE" --dport "$destination_port" -j ACCEPT
}

apply_saved_rules() {
  [[ $ROLE == iran && -s $RULES_FILE ]] || return 0
  local protocol source_port destination_port extra
  while read -r protocol source_port destination_port extra; do
    [[ -z ${protocol:-} || $protocol == \#* ]] && continue
    [[ -z ${extra:-} ]] || die "malformed rule in $RULES_FILE"
    apply_rule "$protocol" "$source_port" "$destination_port"
  done < "$RULES_FILE"
}

start_tunnel() {
  require_root start
  for command_name in ip iptables modprobe sysctl; do require_command "$command_name"; done
  acquire_lock
  load_config || die "not configured; run: sudo gre-manager wizard"
  [[ $MODE != gost ]] || { info "GRE engine is disabled in GOST mode."; return 0; }
  detect_public_iface
  modprobe ip_gre
  ip tunnel del "$IFACE" 2>/dev/null || true
  ip tunnel add "$IFACE" mode gre local "$LOCAL_IP" remote "$REMOTE_IP" ttl 255
  ip address add "$GRE_LOCAL/$GRE_PREFIX" dev "$IFACE"
  ip link set "$IFACE" mtu "$MTU" up
  sysctl -q -w net.ipv4.ip_forward=1
  remove_runtime_rules
  apply_saved_rules
  info "GRE tunnel started: $GRE_LOCAL -> $GRE_REMOTE (${ROLE^^})"
}

stop_tunnel() {
  require_root stop
  acquire_lock
  remove_runtime_rules
  ip tunnel del "$IFACE" 2>/dev/null || true
  info "GRE tunnel stopped."
}

start_private() {
  require_root start-private
  for command_name in ip modprobe sysctl; do require_command "$command_name"; done
  load_config || die "configure IRAN or KHAREJ first"
  [[ $PRIVATE_ENABLED == yes ]] || { info "PRIVATE IPv6 is not enabled in this profile."; return 0; }
  acquire_lock
  modprobe sit
  sysctl -q -w net.ipv6.conf.all.disable_ipv6=0
  ip tunnel del "$PRIVATE_IFACE" 2>/dev/null || true
  ip tunnel add "$PRIVATE_IFACE" mode sit remote "$REMOTE_IP" local "$LOCAL_IP" ttl 255
  ip link set dev "$PRIVATE_IFACE" mtu 1400 up
  local i address peer peer_role
  if [[ $ROLE == iran ]]; then peer_role=kharej; else peer_role=iran; fi
  for ((i=1; i<=10#$PRIVATE_COUNT; i++)); do
    address=$(private_address "$ROLE" "$i")
    peer=$(private_address "$peer_role" "$i")
    ip -6 address add "$address/64" dev "$PRIVATE_IFACE" nodad
    ip -6 route replace "$peer/128" dev "$PRIVATE_IFACE"
  done
  info "PRIVATE IPv6 started: $PRIVATE_LOCAL -> $PRIVATE_REMOTE (SIT / Protocol 41)"
}

stop_private() {
  require_root stop-private
  acquire_lock
  ip tunnel del "$PRIVATE_IFACE" 2>/dev/null || true
  info "RIZAY PRIVATE IPv6 stopped."
}

sync_private_service() {
  local action=${1:-restart}
  [[ $action == restart || $action == start ]] || die "invalid private IPv6 service action"
  load_config || die "configure IRAN or KHAREJ first"
  release_lock
  if [[ $PRIVATE_ENABLED == yes ]]; then
    systemctl enable "$PRIVATE_SERVICE" >/dev/null
    systemctl "$action" "$PRIVATE_SERVICE"
    systemctl enable --now "$PRIVATE_TIMER" >/dev/null
  else
    systemctl disable --now "$PRIVATE_TIMER" "$PRIVATE_SERVICE" >/dev/null 2>&1 || true
  fi
}

private_keepalive() {
  require_root private-keepalive
  load_config || return 0
  [[ $PRIVATE_ENABLED == yes ]] || return 0
  require_command ping
  if LC_ALL=C ping -6 -n -q -c 1 -W 2 "$PRIVATE_REMOTE" >/dev/null 2>&1; then
    info "PRIVATE IPv6 peer replied: $PRIVATE_REMOTE"
  else
    info "PRIVATE IPv6 peer did not reply. Check setup on BOTH servers and IP Protocol 41."
  fi
}

private_menu() {
  require_root private
  load_config || die "configure IRAN or KHAREJ first"
  local choice count i
  while true; do
    load_config
    choice=$(ui_menu "RIZAY - PRIVATE IPv6" "Addresses are automatic. Use the same pair count on IRAN and KHAREJ." \
      1 "Enable / repair PRIVATE IPv6" 2 "List private IPv6 addresses" \
      3 "Change the number of address pairs (advanced)" \
      4 "Test the private IPv6 peer" 0 "Back") || return 0
    case "$choice" in
      1) (enable_private_config; release_lock; sync_private_service) ;;
      2) for ((i=1; i<=10#$PRIVATE_COUNT; i++)); do
           printf 'Pair %d | IRAN %s | KHAREJ %s\n' "$i" "$(private_address iran "$i")" "$(private_address kharej "$i")"
         done ;;
      3) count=$(ui_input "RIZAY - Private IPv6 pairs" "How many pairs? 1 is enough for normal forwarding; maximum 15" "$PRIVATE_COUNT") || continue
         if valid_private_count "$count"; then
           (save_private_count "$count"; release_lock; sync_private_service)
         else ui_message "RIZAY - Private IPv6" "Enter a number between 1 and 15."; fi ;;
      4) private_keepalive ;;
      0) return 0 ;;
    esac
    pause_menu
  done
}

enable_private_config() { PRIVATE_ENABLED=yes; save_config; }
save_private_count() { PRIVATE_COUNT=$1; PRIVATE_ENABLED=yes; save_config; }

start_stack() {
  require_root start
  load_config || die "not configured; run: sudo gre-manager wizard"
  if [[ $MODE != gost ]]; then start_tunnel; else info "GRE is disabled in GOST mode."; fi
  sync_private_service
  if [[ $ROLE == kharej && $PRIVATE_ENABLED == yes || $ROLE == iran && $MODE != gre && -s $GOST_RULES_FILE ]]; then sync_gost; fi
}

stop_stack() {
  require_root stop
  load_config || true
  release_lock
  if command -v systemctl >/dev/null 2>&1; then
    systemctl stop "$GOST_SERVICE" "$PRIVATE_TIMER" "$PRIVATE_SERVICE" >/dev/null 2>&1 || true
  fi
  if [[ $MODE != gost ]]; then stop_tunnel; fi
  info "RIZAY tunnel stack stopped."
}

restart_stack() {
  require_root restart
  load_config || die "not configured; run: sudo gre-manager wizard"
  if [[ $MODE != gost ]]; then stop_tunnel; start_tunnel; fi
  sync_private_service
  if [[ $ROLE == kharej && $PRIVATE_ENABLED == yes || $ROLE == iran && $MODE != gre && -s $GOST_RULES_FILE ]]; then sync_gost; fi
  info "RIZAY tunnel stack restarted."
}

add_rule() {
  if (( $# == 0 )); then add_ports_wizard gre; return; fi
  require_root add-rule
  load_config || die "not configured; run: sudo gre-manager wizard"
  [[ $ROLE == iran ]] || die "run add-rule on the IRAN server; KHAREJ is the destination"
  [[ $MODE != gost ]] || die "GRE rules are disabled in GOST mode; use add-gost or rerun wizard with HYBRID"
  local protocol=${1:-} source_port=${2:-} destination_port=${3:-} tmp
  if [[ -z $protocol ]]; then protocol=$(ui_protocol) || return 0; fi
  [[ -n $protocol ]] || read -r -p "Protocol (tcp/udp): " protocol
  [[ -n $source_port ]] || source_port=$(ui_input "RIZAY - IRAN port" "Port users connect to on the IRAN server:" "")
  [[ -n $destination_port ]] || destination_port=$(ui_input "RIZAY - KHAREJ port" "Final service port on the KHAREJ server:" "$source_port")
  valid_protocol "$protocol" || die "protocol must be tcp or udp"
  valid_port "$source_port" || die "public port must be 1-65535"
  valid_port "$destination_port" || die "KHAREJ port must be 1-65535"
  acquire_lock
  install -d -m 700 "$CONFIG_DIR"
  touch "$RULES_FILE"
  chmod 600 "$RULES_FILE"
  if awk -v p="$protocol" -v s="$source_port" \
    '$1 == p && $2 == s { found=1 } END { exit !found }' "$RULES_FILE"; then
    die "this protocol/public-port pair already has a rule"
  fi
  apply_rule "$protocol" "$source_port" "$destination_port"
  tmp=$(mktemp "$CONFIG_DIR/rules.XXXXXX")
  [[ ! -f $RULES_FILE ]] || cat "$RULES_FILE" > "$tmp"
  printf '%s %s %s\n' "$protocol" "$source_port" "$destination_port" >> "$tmp"
  chmod 600 "$tmp"
  mv -f "$tmp" "$RULES_FILE"
  ui_message "RIZAY - Rule added" "$protocol/$source_port on IRAN now forwards to $GRE_REMOTE:$destination_port on KHAREJ."
}

remove_rule() {
  require_root remove-rule
  load_config || die "not configured; run: sudo gre-manager wizard"
  [[ $ROLE == iran ]] || die "rules are managed on the IRAN server"
  local protocol=${1:-} source_port=${2:-} tmp choice
  if [[ -z $protocol ]]; then
    choice=$(ui_menu "RIZAY - Remove GRE rule" "Choose the rule protocol" 1 "TCP" 2 "UDP" 0 "Cancel") || return 0
    case "$choice" in 1) protocol=tcp ;; 2) protocol=udp ;; *) return 0 ;; esac
  fi
  [[ -n $protocol ]] || read -r -p "Protocol (tcp/udp): " protocol
  [[ -n $source_port ]] || source_port=$(ui_input "RIZAY - Remove rule" "IRAN public port to remove:" "")
  valid_protocol "$protocol" || die "protocol must be tcp or udp"
  valid_port "$source_port" || die "IRAN port must be 1-65535"
  [[ -s $RULES_FILE ]] || die "no saved rules"
  acquire_lock
  if ! awk -v p="$protocol" -v s="$source_port" \
    '$1 == p && $2 == s { found=1 } END { exit !found }' "$RULES_FILE"; then
    die "rule not found: $protocol/$source_port"
  fi
  tmp=$(mktemp "$CONFIG_DIR/rules.XXXXXX")
  awk -v p="$protocol" -v s="$source_port" '!($1 == p && $2 == s)' "$RULES_FILE" > "$tmp"
  chmod 600 "$tmp"
  if [[ -s $tmp ]]; then mv -f "$tmp" "$RULES_FILE"; else rm -f -- "$tmp" "$RULES_FILE"; fi
  remove_runtime_rules
  apply_saved_rules
  ui_message "RIZAY - Rule removed" "$protocol/$source_port was removed and the firewall was rebuilt."
}

list_rules() {
  require_root list-rules
  load_config || die "not configured; run: sudo gre-manager wizard"
  if [[ ! -s $RULES_FILE ]]; then info "No saved rules."; return; fi
  printf '%-8s %-14s %s\n' PROTOCOL IRAN_PORT KHAREJ_PORT
  awk '!/^($|#)/ { printf "%-8s %-14s %s\n", $1, $2, $3 }' "$RULES_FILE"
}

clear_rules() {
  require_root clear-rules
  load_config || true
  acquire_lock
  remove_runtime_rules
  rm -f -- "$RULES_FILE"
  info "All IRAN-to-KHAREJ forwarding rules cleared."
}

gost_arch() {
  case "$(uname -m)" in
    x86_64|amd64) printf 'amd64' ;;
    i386|i486|i586|i686) printf '386' ;;
    aarch64|arm64) printf 'arm64' ;;
    armv7l|armv7) printf 'armv7' ;;
    *) die "GOST does not have a supported build for architecture: $(uname -m)" ;;
  esac
}

install_gost_binary() {
  require_root install-gost
  local force=${1:-} current="" arch asset base work_dir
  if [[ -x $GOST_BIN ]]; then current=$($GOST_BIN -V 2>&1 || true); fi
  if [[ $force != --force && $current == *"$GOST_VERSION"* ]]; then
    info "GOST $GOST_VERSION is already installed for RIZAY."
    return 0
  fi
  for command_name in curl tar sha256sum awk; do require_command "$command_name"; done
  arch=$(gost_arch)
  asset="gost_${GOST_VERSION}_linux_${arch}.tar.gz"
  base="https://github.com/ginuerzh/gost/releases/download/v${GOST_VERSION}"
  work_dir=$(mktemp -d /tmp/rizay-gost.XXXXXX)
  (
    set -Eeuo pipefail
    trap 'rm -rf -- "$work_dir"' EXIT
    info "Downloading official GOST v$GOST_VERSION ($arch)..."
    curl -4 --proto '=https' --tlsv1.2 --connect-timeout 15 --retry 3 -fL "$base/$asset" -o "$work_dir/$asset"
    curl -4 --proto '=https' --tlsv1.2 --connect-timeout 15 --retry 3 -fL "$base/checksums.txt" -o "$work_dir/checksums.txt"
    awk -v file="$asset" '$2 == file || $2 == "*" file { print $1 "  " file; found=1 } END { exit !found }' \
      "$work_dir/checksums.txt" > "$work_dir/selected.sha256"
    cd "$work_dir"
    sha256sum -c selected.sha256
    install -d -m 755 "$work_dir/unpack" "$(dirname "$GOST_BIN")"
    tar -xzf "$asset" -C "$work_dir/unpack"
    [[ -f $work_dir/unpack/gost ]] || die "official GOST archive did not contain the expected binary"
    local candidate_version
    candidate_version=$("$work_dir/unpack/gost" -V)
    [[ $candidate_version == "gost $GOST_VERSION "* ]] || die "downloaded GOST version did not match $GOST_VERSION"
    if [[ -f $GOST_BIN ]]; then
      install -d -m 700 "$CONFIG_DIR/backup"
      cp -p -- "$GOST_BIN" "$CONFIG_DIR/backup/gost.$(date +%Y%m%d%H%M%S)"
    fi
    install -m 755 "$work_dir/unpack/gost" "$GOST_BIN.next"
    mv -f -- "$GOST_BIN.next" "$GOST_BIN"
  )
  "$GOST_BIN" -V
}

gost_target() {
  local transport=$1
  case "$transport" in
    public) printf '%s' "$KHAREJ_IP" ;;
    gre) printf '%s' "$GRE_REMOTE" ;;
    # The private relay resolves the final service on KHAREJ's IPv4 loopback.
    private) printf '127.0.0.1' ;;
    *) die "invalid GOST transport: $transport" ;;
  esac
}

write_gost_config() {
  local tmp protocol source_port destination_port transport extra target count=0
  install -d -m 700 "$CONFIG_DIR"
  tmp=$(mktemp "$CONFIG_DIR/gost.XXXXXX")
  chmod 600 "$tmp"
  if [[ $ROLE == kharej ]]; then
    printf '{"Debug": false, "ServeNodes": ["relay://[%s]:%s"]}\n' "$PRIVATE_LOCAL" "$PRIVATE_RELAY_PORT" > "$tmp"
    mv -f "$tmp" "$GOST_CONFIG_FILE"
    return 0
  fi
  printf '{\n  "Debug": false,\n  "Routes": [\n' > "$tmp"
  while read -r protocol source_port destination_port transport extra; do
    [[ -z ${protocol:-} || $protocol == \#* ]] && continue
    [[ -z ${extra:-} ]] || die "malformed rule in $GOST_RULES_FILE"
    valid_protocol "$protocol" || die "invalid GOST protocol: $protocol"
    valid_port "$source_port" || die "invalid GOST IRAN port: $source_port"
    valid_port "$destination_port" || die "invalid GOST KHAREJ port: $destination_port"
    valid_transport "$transport" || die "invalid GOST transport: $transport"
    target=$(gost_target "$transport")
    if (( count > 0 )); then printf ',\n' >> "$tmp"; fi
    printf '    {"ServeNodes": ["%s://0.0.0.0:%s/%s:%s"], "Retries": 3' "$protocol" "$source_port" "$target" "$destination_port" >> "$tmp"
    if [[ $transport == private ]]; then
      printf ', "ChainNodes": ["relay://[%s]:%s?nodelay=true"]' "$PRIVATE_REMOTE" "$PRIVATE_RELAY_PORT" >> "$tmp"
    fi
    printf '}' >> "$tmp"
    ((count+=1))
  done < "$GOST_RULES_FILE"
  (( count > 0 )) || { rm -f -- "$tmp"; die "no valid GOST rules to render"; }
  printf '\n  ]\n}\n' >> "$tmp"
  mv -f "$tmp" "$GOST_CONFIG_FILE"
}

sync_gost() {
  require_root sync-gost
  load_config || die "not configured; run: sudo gre-manager wizard"
  acquire_lock
  if [[ $ROLE == iran && ! -s $GOST_RULES_FILE || $ROLE == kharej && $PRIVATE_ENABLED != yes ]]; then
    rm -f -- "$GOST_CONFIG_FILE"
    if command -v systemctl >/dev/null 2>&1; then systemctl disable --now "$GOST_SERVICE" >/dev/null 2>&1 || true; fi
    info "GRE / iptables mode: GOST is not needed for these saved ports."
    return 0
  fi
  install_gost_binary
  if [[ $ROLE == kharej ]] || awk '$4 == "private" { found=1 } END { exit !found }' "$GOST_RULES_FILE"; then
    if [[ $PRIVATE_ENABLED != yes ]]; then enable_private_config; fi
    release_lock
    sync_private_service start
    acquire_lock
  fi
  write_gost_config
  if [[ -f $OLD_GOST_CONFIG_FILE ]]; then
    install -d -m 700 "$CONFIG_DIR/backup"
    mv -- "$OLD_GOST_CONFIG_FILE" "$CONFIG_DIR/backup/gost-v3.$(date +%Y%m%d%H%M%S).yaml"
  fi
  release_lock
  systemctl daemon-reload
  systemctl enable "$GOST_SERVICE" >/dev/null
  if systemctl restart "$GOST_SERVICE"; then
    if ! systemctl is-active --quiet "$GOST_SERVICE"; then die "GOST exited after startup; check GOST Logs in option 5"; fi
    info "GOST service rebuilt from saved rules."
  else
    systemctl --no-pager --full status "$GOST_SERVICE" || true
    die "GOST could not start; another service may already use a configured IRAN port"
  fi
}

add_gost_rule() {
  if (( $# == 0 )); then add_ports_wizard gost-public; return; fi
  require_root add-gost
  load_config || die "not configured; run: sudo gre-manager wizard"
  [[ $ROLE == iran ]] || die "run add-gost on IRAN; KHAREJ is the destination"
  local protocol=${1:-} source_port=${2:-} destination_port=${3:-} transport=${4:-} tmp
  if [[ -z $protocol ]]; then protocol=$(ui_protocol) || return 0; fi
  [[ -n $protocol ]] || read -r -p "Protocol (tcp/udp): " protocol
  [[ -n $source_port ]] || source_port=$(ui_input "RIZAY - GOST IRAN port" "Port users connect to on IRAN:" "")
  [[ -n $destination_port ]] || destination_port=$(ui_input "RIZAY - GOST KHAREJ port" "Final service port on KHAREJ:" "$source_port")
  transport=${transport:-public}
  valid_protocol "$protocol" || die "protocol must be tcp or udp"
  valid_port "$source_port" || die "IRAN port must be 1-65535"
  valid_port "$destination_port" || die "KHAREJ port must be 1-65535"
  valid_transport "$transport" || die "path must be public, gre or private"
  [[ $transport != gre || $MODE != gost ]] || die "GRE path requires HYBRID or GRE mode"
  acquire_lock
  install -d -m 700 "$CONFIG_DIR"
  touch "$GOST_RULES_FILE"
  chmod 600 "$GOST_RULES_FILE"
  if awk -v p="$protocol" -v s="$source_port" \
    '$1 == p && $2 == s { found=1 } END { exit !found }' "$GOST_RULES_FILE"; then
    die "this GOST protocol/IRAN-port pair already exists"
  fi
  tmp=$(mktemp "$CONFIG_DIR/gost-rules.XXXXXX")
  cat "$GOST_RULES_FILE" > "$tmp"
  printf '%s %s %s %s\n' "$protocol" "$source_port" "$destination_port" "$transport" >> "$tmp"
  chmod 600 "$tmp"
  mv -f "$tmp" "$GOST_RULES_FILE"
  if [[ $MODE == gre ]]; then MODE=hybrid; save_config; fi
  sync_gost
  ui_message "RIZAY - GOST rule added" "$protocol/$source_port on IRAN now forwards through ${transport^^} to KHAREJ port $destination_port."
}


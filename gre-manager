  local choice
  while true; do
    choice=$(whiptail --title "RIZAY - Maintenance" --menu "Repair and safe optimization" 17 78 4 \
      repair "Rebuild GRE + GOST and run Doctor" \
      optimize "Apply safe FQ / MTU / optional BBR tuning" \
      restore "Remove the RIZAY optimization profile" \
      back "Back to main panel" 3>&1 1>&2 2>&3) || return 0
    case "$choice" in repair) repair || true ;; optimize) optimize_network || true ;;
      restore) restore_network_defaults || true ;; back) return 0 ;; esac
    pause_menu
  done
}

menu() {
  require_root menu
  local choice
  while true; do
    clear 2>/dev/null || true
    banner
    if command -v whiptail >/dev/null 2>&1; then
      choice=$(whiptail --title "RIZAY Tunnel Manager v$VERSION" --menu \
        "IRAN <-> KHAREJ | GRE + GOST professional panel" 21 82 7 \
        quick "Quick HYBRID setup wizard" \
        tunnels "Tunnel Center - GRE + GOST engines" \
        ports "Port Manager - GRE + GOST rules" \
        health "Health Center - loss, RTT and Doctor" \
        status "Live Dashboard" \
        maintenance "Repair and safe optimization" \
        about "About RIZAY / @rizay_041" \
        exit "Exit" 3>&1 1>&2 2>&3) || return 0
    else
      printf '1) Setup  2) Status  3) Health  4) Add GRE  5) Add GOST\n6) Doctor 7) Restart 8) About   9) Exit\n'
      read -r -p "Choice: " choice
      case "$choice" in 1) choice=quick;; 2) choice=status;; 3) choice=health-cli;; 4) choice=add-gre;; 5) choice=add-gost;; 6) choice=doctor-cli;; 7) choice=restart-cli;; 8) choice=about;; 9) choice=exit;; esac
    fi
    case "$choice" in
      quick) wizard; return 0 ;; tunnels) tunnel_menu ;; ports) port_menu ;; health) health_menu ;;
      status) status || true ;; maintenance) maintenance_menu ;; about) about ;;
      health-cli) health 50 || true ;; doctor-cli) doctor || true ;; restart-cli) restart_stack || true ;;
      add-gre) add_rule ;; add-gost) add_gost_rule ;; exit) return 0 ;; *) info "Invalid choice." ;;
    esac
    [[ $choice == tunnels || $choice == ports || $choice == health || $choice == maintenance ]] || pause_menu
  done
}

usage() {
  cat <<'EOF'
RIZAY Tunnel Manager - HYBRID GRE + GOST for IRAN and KHAREJ

Usage: gre-manager COMMAND [ARGS]
  wizard                     Graphical IRAN/KHAREJ setup
  doctor                     Run deterministic system and firewall checks
  health [5-200] [TCP_PORT]  Measure loss, jitter, readiness and optional service
  start|stop|restart         Control the selected GRE + GOST stack
  start-gre|stop-gre         Control only the GRE systemd engine
  repair                     Rebuild saved GRE/GOST state and run Doctor
  status [--json]            Show both engines for humans or automation
  add-rule [tcp|udp SRC DST] Forward an IRAN port to the KHAREJ server
  remove-rule [tcp|udp SRC]  Remove one forwarding rule safely
  list-rules                 List persistent forwarding rules
  add-gost [PROTO SRC DST PATH]  Add GOST rule; PATH is public or gre
  remove-gost [PROTO SRC]        Remove one GOST rule
  list-gost|clear-gost|sync-gost Manage persistent GOST forwarding
  install-gost [--force]     Install verified official GOST v3.3.0
  gost-logs [LINES]          Show GOST service logs
  firewall                   Show live iptables packet/byte counters
  clear-rules                Remove all forwarding rules
  optimize|restore-network   Manage safe persistent network tuning
  menu                       Open the graphical management menu
  version                    Print version
  help                       Show this help
EOF
}

main() {
  case "${1:-menu}" in
    wizard|configure) wizard ;; doctor) doctor ;; health) shift; health "${1:-50}" "${2:-}" ;;
    start) start_stack ;; stop) stop_stack ;; restart) restart_stack ;;
    start-gre) start_tunnel ;; stop-gre) stop_tunnel ;;
    repair) repair ;; status) shift; status "${1:-}" ;; add-rule) shift; add_rule "$@" ;;
    remove-rule) shift; remove_rule "$@" ;; list-rules) list_rules ;; firewall) firewall_rules ;;
    clear-rules) clear_rules ;; add-gost) shift; add_gost_rule "$@" ;;
    remove-gost) shift; remove_gost_rule "$@" ;; list-gost) list_gost_rules ;;
    clear-gost) clear_gost_rules ;; sync-gost) sync_gost ;; install-gost) shift; install_gost_binary "${1:-}" ;;
    gost-logs) shift; gost_logs "${1:-80}" ;; optimize) optimize_network ;;
    restore-network) restore_network_defaults ;; menu) menu ;; version|--version|-v) info "$VERSION" ;;
    help|--help|-h) usage ;; *) usage >&2; exit 2 ;;
  esac
}

if [[ ${BASH_SOURCE[0]} == "$0" ]]; then
  main "$@"
fi

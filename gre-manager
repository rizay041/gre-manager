#!/usr/bin/env bash
set -Eeuo pipefail

readonly VERSION="6.0.0"
readonly CONFIG_DIR="${GRE_MANAGER_CONFIG_DIR:-/etc/gre-manager}"
readonly CONFIG_FILE="$CONFIG_DIR/config.conf"
readonly RULES_FILE="$CONFIG_DIR/rules.conf"
readonly GOST_RULES_FILE="$CONFIG_DIR/gost-rules.conf"
readonly GOST_CONFIG_FILE="$CONFIG_DIR/gost.json"
readonly OLD_GOST_CONFIG_FILE="$CONFIG_DIR/gost.yaml"
readonly GOST_BIN="${GRE_MANAGER_GOST_BIN:-/usr/local/lib/gre-manager/gost}"
readonly GOST_SERVICE="rizay-gost.service"
readonly GOST_VERSION="2.12.0"
readonly PRIVATE_IFACE="rizay-private"
readonly PRIVATE_SERVICE="rizay-private.service"
readonly PRIVATE_TIMER="rizay-private-keepalive.timer"
readonly PRIVATE_RELAY_PORT="6080"
readonly OPTIMIZE_FILE="/etc/sysctl.d/99-rizay-tunnel.conf"
readonly IFACE="gre-manager"
readonly NAT_CHAIN="GRE_MANAGER_NAT"
readonly FWD_CHAIN="GRE_MANAGER_FWD"
readonly LOCK_FILE="${GRE_MANAGER_LOCK_FILE:-/run/lock/gre-manager.lock}"

ROLE=""
MODE="hybrid"
IRAN_IP=""
KHAREJ_IP=""
LOCAL_IP=""
REMOTE_IP=""
GRE_LOCAL=""
GRE_REMOTE=""
GRE_PREFIX="30"
MTU="1400"
PRIVATE_ENABLED="no"
PRIVATE_COUNT="1"
PRIVATE_LOCAL=""
PRIVATE_REMOTE=""
PUBLIC_IFACE=""
PING_LOSS="100"
PING_MIN="-"
PING_AVG="-"
PING_MAX="-"
PING_MDEV="-"
LOCK_HELD=0
DOCTOR_PASS=0
DOCTOR_WARN=0
DOCTOR_FAIL=0
PORT_LIST=""
PORT_LIST_ERROR=""
PARSED_PORTS=()
BATCH_SOURCES=()
BATCH_DESTINATIONS=()
BATCH_PROTOCOLS=()
BATCH_ERROR=""


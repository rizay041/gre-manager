doctor_item() {
  local state=$1 label=$2 detail=$3 color='' reset=''
  if [[ -t 1 ]]; then
    case "$state" in PASS) color='\033[1;32m';; WARN) color='\033[1;33m';; FAIL) color='\033[1;31m';; esac
    reset='\033[0m'
  fi
  printf '%b[%-4s]%b %-24s %s\n' "$color" "$state" "$reset" "$label" "$detail"
  case "$state" in
    PASS) ((DOCTOR_PASS+=1)) ;;
    WARN) ((DOCTOR_WARN+=1)) ;;
    FAIL) ((DOCTOR_FAIL+=1)) ;;
  esac
}

doctor() {
  require_root doctor
  local command_name mode local_found=0 malformed=0 gost_malformed=0 gost_version=""
  DOCTOR_PASS=0; DOCTOR_WARN=0; DOCTOR_FAIL=0
  banner
  info "Running deterministic preflight checks..."
  info ""
  for command_name in ip iptables ping sysctl modprobe flock awk sed stat; do
    if command -v "$command_name" >/dev/null 2>&1; then
      doctor_item PASS "command: $command_name" "available"
    else
      doctor_item FAIL "command: $command_name" "missing"
    fi
  done
  if [[ ! -r $CONFIG_FILE ]]; then
    doctor_item FAIL "configuration" "missing; run sudo gre-manager wizard"
    printf '\nSummary: %d PASS, %d WARN, %d FAIL\n' "$DOCTOR_PASS" "$DOCTOR_WARN" "$DOCTOR_FAIL"
    return 1
  fi
  load_config
  doctor_item PASS "configuration" "valid ${ROLE^^} / ${MODE^^} profile"
  mode=$(stat -c '%a' "$CONFIG_FILE" 2>/dev/null || true)
  if [[ $mode == 600 ]]; then doctor_item PASS "config permissions" "600"; else doctor_item WARN "config permissions" "expected 600, found ${mode:-unknown}"; fi
  if [[ $MODE != gost ]]; then
    if modprobe -n ip_gre >/dev/null 2>&1; then doctor_item PASS "GRE kernel module" "available"; else doctor_item FAIL "GRE kernel module" "ip_gre unavailable"; fi
  else
    doctor_item PASS "GRE kernel module" "not required in GOST mode"
  fi
  if ip route get "$REMOTE_IP" >/dev/null 2>&1; then doctor_item PASS "remote route" "$REMOTE_IP is routable"; else doctor_item FAIL "remote route" "no route to $REMOTE_IP"; fi
  if ip -o -4 address show | awk '{print $4}' | cut -d/ -f1 | grep -Fxq "$LOCAL_IP"; then local_found=1; fi
  if (( local_found == 1 )); then
    doctor_item PASS "local public IP" "$LOCAL_IP is assigned"
  else
    doctor_item WARN "local public IP" "$LOCAL_IP is not assigned locally; cloud NAT may be in use"
  fi
  if [[ $MODE == gost ]]; then
    doctor_item PASS "GRE interface" "disabled by selected mode"
  elif ip link show "$IFACE" >/dev/null 2>&1; then doctor_item PASS "GRE interface" "present"; else doctor_item WARN "GRE interface" "not running"; fi
  if [[ $(sysctl -n net.ipv4.ip_forward 2>/dev/null || true) == 1 ]]; then doctor_item PASS "IPv4 forwarding" "enabled"; else doctor_item WARN "IPv4 forwarding" "disabled until tunnel start"; fi
  if command -v systemctl >/dev/null 2>&1 && systemctl is-enabled --quiet gre-manager.service 2>/dev/null; then
    doctor_item PASS "systemd service" "enabled"
  else
    doctor_item WARN "systemd service" "not enabled"
  fi
  if [[ -s $RULES_FILE ]]; then
    while read -r protocol source_port destination_port extra; do
      [[ -z ${protocol:-} || $protocol == \#* ]] && continue
      if [[ -n ${extra:-} ]] || ! valid_protocol "$protocol" || ! valid_port "$source_port" || ! valid_port "$destination_port"; then malformed=1; fi
    done < "$RULES_FILE"
    if (( malformed == 0 )); then doctor_item PASS "rules file" "syntax valid"; else doctor_item FAIL "rules file" "contains malformed entries"; fi
  else
    doctor_item PASS "rules file" "no saved forwarding rules"
  fi
  if [[ $ROLE == iran && -s $RULES_FILE ]]; then
    if ipt -t nat -S "$NAT_CHAIN" >/dev/null 2>&1 && ipt -S "$FWD_CHAIN" >/dev/null 2>&1; then
      doctor_item PASS "firewall runtime" "RIZAY chains active"
    else
      doctor_item WARN "firewall runtime" "saved rules exist but runtime chains are missing"
    fi
  fi
  if [[ $PRIVATE_ENABLED == yes ]]; then
    if modprobe -n sit >/dev/null 2>&1; then doctor_item PASS "SIT kernel module" "available (IP Protocol 41)";
    else doctor_item FAIL "SIT kernel module" "unavailable"; fi
    if ip -6 address show dev "$PRIVATE_IFACE" 2>/dev/null | grep -Fq "$PRIVATE_LOCAL"; then
      doctor_item PASS "PRIVATE IPv6" "$PRIVATE_LOCAL"
    else doctor_item FAIL "PRIVATE IPv6" "missing; use option 10 / repair"; fi
    if systemctl is-active --quiet "$PRIVATE_SERVICE" 2>/dev/null; then doctor_item PASS "Private IPv6 service" "active";
    else doctor_item WARN "Private IPv6 service" "not active"; fi
    if systemctl is-active --quiet "$PRIVATE_TIMER" 2>/dev/null; then doctor_item PASS "IPv6 keepalive timer" "active";
    else doctor_item WARN "IPv6 keepalive timer" "not active"; fi
  fi
  if [[ $ROLE == iran && $MODE != gre || $ROLE == kharej && $PRIVATE_ENABLED == yes ]]; then
    if [[ -x $GOST_BIN ]]; then
      gost_version=$($GOST_BIN -V 2>&1 || true)
      if [[ $gost_version == *"$GOST_VERSION"* ]]; then doctor_item PASS "GOST binary" "$gost_version"; else doctor_item WARN "GOST binary" "unexpected version: ${gost_version:-unknown}"; fi
    elif [[ -s $GOST_RULES_FILE ]]; then
      doctor_item FAIL "GOST binary" "missing while GOST rules exist"
    else
      doctor_item WARN "GOST binary" "installed automatically with the first rule"
    fi
    if [[ $ROLE == kharej ]]; then
      doctor_item PASS "GOST server role" "private IPv6 relay -> IPv4 final services"
      if systemctl is-active --quiet "$GOST_SERVICE" 2>/dev/null; then doctor_item PASS "GOST relay service" "active";
      else doctor_item FAIL "GOST relay service" "not active"; fi
    elif [[ -s $GOST_RULES_FILE ]]; then
      while read -r protocol source_port destination_port transport extra; do
        [[ -z ${protocol:-} || $protocol == \#* ]] && continue
        if [[ -n ${extra:-} ]] || ! valid_protocol "$protocol" || ! valid_port "$source_port" || \
          ! valid_port "$destination_port" || ! valid_transport "$transport"; then gost_malformed=1; fi
      done < "$GOST_RULES_FILE"
      if (( gost_malformed == 0 )); then doctor_item PASS "GOST rules" "syntax valid"; else doctor_item FAIL "GOST rules" "contains malformed entries"; fi
      if systemctl is-active --quiet "$GOST_SERVICE" 2>/dev/null; then doctor_item PASS "GOST service" "active"; else doctor_item FAIL "GOST service" "rules exist but service is not active"; fi
    else
      doctor_item WARN "GOST rules" "none configured yet"
    fi
  fi
  if command -v firewall-cmd >/dev/null 2>&1 && systemctl is-active --quiet firewalld 2>/dev/null; then
    doctor_item WARN "firewalld" "active; reloads may remove direct iptables rules"
  fi
  if command -v ufw >/dev/null 2>&1 && ufw status 2>/dev/null | grep -q '^Status: active'; then
    doctor_item WARN "UFW" "active; verify Protocol 41 (SIT), 47 (GRE), ICMPv6 and FORWARD policy"
  fi
  printf '\nSummary: %d PASS, %d WARN, %d FAIL\n' "$DOCTOR_PASS" "$DOCTOR_WARN" "$DOCTOR_FAIL"
  (( DOCTOR_FAIL == 0 ))
}


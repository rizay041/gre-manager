usage() {
  cat <<'EOF'
RIZAY Tunnel Manager - HYBRID GRE + GOST for IRAN and KHAREJ

Usage: gre-manager COMMAND [ARGS]
  wizard [iran|kharej]       Step-by-step setup with comma-separated ports
  add-ports                  Add multiple ports through the numbered panel
  doctor                     Run deterministic system and firewall checks
  health [5-200] [TCP_PORT]  Measure loss, jitter, readiness and optional service
  start|stop|restart         Control the selected GRE + GOST stack
  start-gre|stop-gre         Control only the GRE systemd engine
  repair                     Rebuild saved GRE/GOST state and run Doctor
  status [--json]            Show both engines for humans or automation
  add-rule [tcp|udp SRC DST] Forward an IRAN port to the KHAREJ server
  remove-rule [tcp|udp SRC]  Remove one forwarding rule safely
  list-rules                 List persistent forwarding rules
  add-gost [PROTO SRC DST PATH]  GOST v2; PATH is private, public or gre
  remove-gost [PROTO SRC]        Remove one GOST rule
  list-gost|clear-gost|sync-gost Manage persistent GOST forwarding
  install-gost [--force]     Install verified official GOST v2.12.0
  private                    Private IPv6 status / repair / address pairs
  start-private|stop-private Control the SIT IPv6 interface
  private-keepalive           Ping the private IPv6 peer
  gost-logs [LINES]          Show GOST service logs
  firewall                   Show live iptables packet/byte counters
  clear-rules                Remove all forwarding rules
  optimize|restore-network   Manage safe persistent network tuning
  menu                       Open the graphical management menu
  version                    Print version
  help                       Show this help
EOF
}

main() {
  case "${1:-menu}" in
    wizard|configure) shift; wizard "${1:-}" ;; add-ports) add_ports_wizard ;;
    doctor) doctor ;; health) shift; health "${1:-50}" "${2:-}" ;;
    start) start_stack ;; stop) stop_stack ;; restart) restart_stack ;;
    start-gre) start_tunnel ;; stop-gre) stop_tunnel ;;
    start-private) start_private ;; stop-private) stop_private ;; private) private_menu ;;
    private-keepalive) private_keepalive ;;
    repair) repair ;; status) shift; status "${1:-}" ;; add-rule) shift; add_rule "$@" ;;
    remove-rule) shift; remove_rule "$@" ;; list-rules) list_rules ;; firewall) firewall_rules ;;
    clear-rules) clear_rules ;; add-gost) shift; add_gost_rule "$@" ;;
    remove-gost) shift; remove_gost_rule "$@" ;; list-gost) list_gost_rules ;;
    clear-gost) clear_gost_rules ;; sync-gost) sync_gost ;; install-gost) shift; install_gost_binary "${1:-}" ;;
    gost-logs) shift; gost_logs "${1:-80}" ;; optimize) optimize_network ;;
    restore-network) restore_network_defaults ;; menu) menu ;; version|--version|-v) info "$VERSION" ;;
    help|--help|-h) usage ;; *) usage >&2; exit 2 ;;
  esac
}

if [[ ${BASH_SOURCE[0]} == "$0" ]]; then
  main "$@"
fi

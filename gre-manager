#!/usr/bin/env bash
set -Eeuo pipefail

readonly VERSION="3.0.0"
readonly CONFIG_DIR="/etc/gre-manager"
readonly CONFIG_FILE="$CONFIG_DIR/config.conf"
readonly RULES_FILE="$CONFIG_DIR/rules.conf"
readonly IFACE="gre-manager"
readonly NAT_CHAIN="GRE_MANAGER_NAT"
readonly FWD_CHAIN="GRE_MANAGER_FWD"

ROLE=""
IRAN_IP=""
KHAREJ_IP=""
LOCAL_IP=""
REMOTE_IP=""
GRE_LOCAL=""
GRE_REMOTE=""
GRE_PREFIX="30"
MTU="1400"
PUBLIC_IFACE=""
PING_LOSS="100"
PING_MIN="-"
PING_AVG="-"
PING_MAX="-"

die() { printf 'Error: %s\n' "$*" >&2; exit 1; }
info() { printf '%s\n' "$*"; }
require_root() { [[ ${EUID:-$(id -u)} -eq 0 ]] || die "run with sudo: sudo gre-manager $*"; }
require_command() { command -v "$1" >/dev/null 2>&1 || die "required command not found: $1"; }

banner() {
  local cyan='' reset=''
  if [[ -t 1 ]]; then cyan='\033[1;36m'; reset='\033[0m'; fi
  printf '%b' "$cyan"
  cat <<'EOF'
......   .....  ......   ...   ..    ..
..   ..    ..      ..   .. ..   ..  ..
......     ..     ..    .......    ..
..  ..     ..    ..     ..   ..    ..
..   ..  .....  ......  ..   ..    ..
EOF
  printf '%bGRE Manager v%s%b\n\n' "$reset" "$VERSION" "$reset"
}

valid_ipv4() {
  local ip=$1 IFS=. octets i
  [[ $ip =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ ]] || return 1
  read -r -a octets <<< "$ip"
  for i in "${octets[@]}"; do
    [[ $i =~ ^[0-9]{1,3}$ && 10#$i -le 255 ]] || return 1
  done
}

valid_port() { [[ $1 =~ ^[0-9]+$ && 10#$1 -ge 1 && 10#$1 -le 65535 ]]; }
valid_mtu() { [[ $1 =~ ^[0-9]+$ && 10#$1 -ge 576 && 10#$1 -le 9000 ]]; }
valid_protocol() { [[ $1 == tcp || $1 == udp ]]; }
valid_samples() { [[ $1 =~ ^[0-9]+$ && 10#$1 -ge 5 && 10#$1 -le 200 ]]; }

derive_endpoints() {
  case "$ROLE" in
    iran)
      LOCAL_IP=$IRAN_IP
      REMOTE_IP=$KHAREJ_IP
      GRE_LOCAL="10.77.0.1"
      GRE_REMOTE="10.77.0.2"
      ;;
    kharej)
      LOCAL_IP=$KHAREJ_IP
      REMOTE_IP=$IRAN_IP
      GRE_LOCAL="10.77.0.2"
      GRE_REMOTE="10.77.0.1"
      ;;
    *) die "invalid server role; run: sudo gre-manager wizard" ;;
  esac
}

validate_config() {
  [[ $ROLE == iran || $ROLE == kharej ]] || die "role must be IRAN or KHAREJ"
  valid_ipv4 "$IRAN_IP" || die "invalid IRAN public IPv4 address"
  valid_ipv4 "$KHAREJ_IP" || die "invalid KHAREJ public IPv4 address"
  [[ $IRAN_IP != "$KHAREJ_IP" ]] || die "IRAN and KHAREJ IPs must be different"
  valid_mtu "$MTU" || die "MTU must be between 576 and 9000"
  derive_endpoints
}

load_config() {
  [[ -r $CONFIG_FILE ]] || return 1
  local key value
  while IFS='=' read -r key value; do
    case "$key" in
      ROLE) ROLE=$value ;;
      IRAN_IP) IRAN_IP=$value ;;
      KHAREJ_IP) KHAREJ_IP=$value ;;
      MTU) MTU=$value ;;
    esac
  done < "$CONFIG_FILE"
  validate_config
}

save_config() {
  validate_config
  install -d -m 700 "$CONFIG_DIR"
  local tmp
  tmp=$(mktemp "$CONFIG_DIR/config.XXXXXX")
  chmod 600 "$tmp"
  printf 'ROLE=%s\nIRAN_IP=%s\nKHAREJ_IP=%s\nMTU=%s\n' \
    "$ROLE" "$IRAN_IP" "$KHAREJ_IP" "$MTU" > "$tmp"
  mv -f "$tmp" "$CONFIG_FILE"
}

ui_input() {
  local title=$1 prompt=$2 default_value=${3:-} result
  if command -v whiptail >/dev/null 2>&1; then
    result=$(whiptail --title "$title" --inputbox "$prompt" 10 72 "$default_value" 3>&1 1>&2 2>&3) || return 1
    printf '%s' "$result"
  else
    read -r -p "$prompt [$default_value]: " result
    printf '%s' "${result:-$default_value}"
  fi
}

ui_message() {
  local title=$1 message=$2
  if command -v whiptail >/dev/null 2>&1; then
    whiptail --title "$title" --msgbox "$message" 14 76
  else
    printf '\n%s\n%s\n\n' "$title" "$message"
  fi
}

wizard() {
  require_root wizard
  local role_choice
  clear 2>/dev/null || true
  banner
  if command -v whiptail >/dev/null 2>&1; then
    role_choice=$(whiptail --title "RIZAY v$VERSION - Server role" \
      --menu "This setup runs on both servers. Which server is this?" 16 78 2 \
      IRAN "Gateway - receives users and forwards ports" \
      KHAREJ "Destination - runs the final services" \
      3>&1 1>&2 2>&3) || die "setup cancelled"
    ROLE=${role_choice,,}
  else
    read -r -p "Server role (IRAN/KHAREJ): " ROLE
    ROLE=${ROLE,,}
  fi
  while true; do
    IRAN_IP=$(ui_input "RIZAY - IRAN endpoint" "Public IPv4 of the IRAN server:" "$IRAN_IP") || die "setup cancelled"
    valid_ipv4 "$IRAN_IP" && break
    ui_message "RIZAY - Invalid IP" "Enter a valid public IPv4 for IRAN. Example: 203.0.113.10"
  done
  while true; do
    KHAREJ_IP=$(ui_input "RIZAY - KHAREJ endpoint" "Public IPv4 of the KHAREJ destination server:" "$KHAREJ_IP") || die "setup cancelled"
    if valid_ipv4 "$KHAREJ_IP" && [[ $KHAREJ_IP != "$IRAN_IP" ]]; then break; fi
    ui_message "RIZAY - Invalid IP" "Enter a valid KHAREJ IPv4 different from the IRAN IP."
  done
  while true; do
    MTU=$(ui_input "RIZAY - MTU" "Tunnel MTU (1400 is recommended):" "${MTU:-1400}") || die "setup cancelled"
    valid_mtu "$MTU" && break
    ui_message "RIZAY - Invalid MTU" "MTU must be a number between 576 and 9000."
  done
  validate_config

  local role_text summary
  if [[ $ROLE == iran ]]; then role_text="IRAN gateway / port-forward source"; else role_text="KHAREJ destination"; fi
  summary="Role: $role_text
IRAN public IP: $IRAN_IP
KHAREJ public IP: $KHAREJ_IP
Local GRE IP: $GRE_LOCAL/$GRE_PREFIX
Remote GRE IP: $GRE_REMOTE
MTU: $MTU"
  if command -v whiptail >/dev/null 2>&1; then
    whiptail --title "RIZAY - Confirm configuration" --yesno "$summary" 17 76 || die "setup cancelled"
  else
    printf '\n%s\n' "$summary"
  fi

  save_config
  start_tunnel
  command -v systemctl >/dev/null 2>&1 && systemctl enable gre-manager.service >/dev/null 2>&1 || true
  clear 2>/dev/null || true
  banner
  info "$summary"
  if [[ $ROLE == iran ]]; then
    info ""
    info "IRAN gateway is ready. Add a forward with:"
    info "  sudo gre-manager add-rule tcp IRAN_PORT KHAREJ_PORT"
  else
    info ""
    info "KHAREJ destination is ready. Configure the IRAN server next."
  fi
  info ""
  health 20 || true
}

detect_public_iface() {
  PUBLIC_IFACE=$(ip route show default 2>/dev/null | awk 'NR == 1 { print $5 }')
  [[ -n $PUBLIC_IFACE ]] || die "could not detect the public network interface"
}

remove_runtime_rules() {
  iptables -t nat -D PREROUTING -j "$NAT_CHAIN" 2>/dev/null || true
  iptables -D FORWARD -j "$FWD_CHAIN" 2>/dev/null || true
  iptables -t nat -D POSTROUTING -o "$IFACE" -j MASQUERADE 2>/dev/null || true
  iptables -t nat -F "$NAT_CHAIN" 2>/dev/null || true
  iptables -F "$FWD_CHAIN" 2>/dev/null || true
  iptables -t nat -X "$NAT_CHAIN" 2>/dev/null || true
  iptables -X "$FWD_CHAIN" 2>/dev/null || true
}

ensure_runtime_chains() {
  [[ $ROLE == iran ]] || return 0
  [[ -n $PUBLIC_IFACE ]] || detect_public_iface
  iptables -t nat -N "$NAT_CHAIN" 2>/dev/null || true
  iptables -N "$FWD_CHAIN" 2>/dev/null || true
  iptables -t nat -C PREROUTING -j "$NAT_CHAIN" 2>/dev/null || iptables -t nat -A PREROUTING -j "$NAT_CHAIN"
  iptables -C FORWARD -j "$FWD_CHAIN" 2>/dev/null || iptables -A FORWARD -j "$FWD_CHAIN"
  iptables -t nat -C POSTROUTING -o "$IFACE" -j MASQUERADE 2>/dev/null || \
    iptables -t nat -A POSTROUTING -o "$IFACE" -j MASQUERADE
  iptables -C "$FWD_CHAIN" -i "$IFACE" -o "$PUBLIC_IFACE" -m conntrack \
    --ctstate ESTABLISHED,RELATED -j ACCEPT 2>/dev/null || \
    iptables -A "$FWD_CHAIN" -i "$IFACE" -o "$PUBLIC_IFACE" -m conntrack \
      --ctstate ESTABLISHED,RELATED -j ACCEPT
}

apply_rule() {
  local protocol=$1 source_port=$2 destination_port=$3
  [[ $ROLE == iran ]] || die "port forwarding must be configured on the IRAN gateway"
  valid_protocol "$protocol" || die "invalid protocol in rules file: $protocol"
  valid_port "$source_port" || die "invalid public port in rules file: $source_port"
  valid_port "$destination_port" || die "invalid KHAREJ port in rules file: $destination_port"
  ensure_runtime_chains
  iptables -t nat -C "$NAT_CHAIN" -i "$PUBLIC_IFACE" -p "$protocol" --dport "$source_port" \
    -j DNAT --to-destination "$GRE_REMOTE:$destination_port" 2>/dev/null || \
    iptables -t nat -A "$NAT_CHAIN" -i "$PUBLIC_IFACE" -p "$protocol" --dport "$source_port" \
      -j DNAT --to-destination "$GRE_REMOTE:$destination_port"
  iptables -C "$FWD_CHAIN" -i "$PUBLIC_IFACE" -o "$IFACE" -p "$protocol" \
    -d "$GRE_REMOTE" --dport "$destination_port" -j ACCEPT 2>/dev/null || \
    iptables -A "$FWD_CHAIN" -i "$PUBLIC_IFACE" -o "$IFACE" -p "$protocol" \
      -d "$GRE_REMOTE" --dport "$destination_port" -j ACCEPT
}

apply_saved_rules() {
  [[ $ROLE == iran && -s $RULES_FILE ]] || return 0
  local protocol source_port destination_port extra
  while read -r protocol source_port destination_port extra; do
    [[ -z ${protocol:-} || $protocol == \#* ]] && continue
    [[ -z ${extra:-} ]] || die "malformed rule in $RULES_FILE"
    apply_rule "$protocol" "$source_port" "$destination_port"
  done < "$RULES_FILE"
}

start_tunnel() {
  require_root start
  for command_name in ip iptables modprobe sysctl; do require_command "$command_name"; done
  load_config || die "not configured; run: sudo gre-manager wizard"
  detect_public_iface
  modprobe ip_gre
  ip tunnel del "$IFACE" 2>/dev/null || true
  ip tunnel add "$IFACE" mode gre local "$LOCAL_IP" remote "$REMOTE_IP" ttl 255
  ip address add "$GRE_LOCAL/$GRE_PREFIX" dev "$IFACE"
  ip link set "$IFACE" mtu "$MTU" up
  sysctl -q -w net.ipv4.ip_forward=1
  remove_runtime_rules
  apply_saved_rules
  info "GRE tunnel started: $GRE_LOCAL -> $GRE_REMOTE (${ROLE^^})"
}

stop_tunnel() {
  require_root stop
  remove_runtime_rules
  ip tunnel del "$IFACE" 2>/dev/null || true
  info "GRE tunnel stopped."
}

add_rule() {
  require_root add-rule
  load_config || die "not configured; run: sudo gre-manager wizard"
  [[ $ROLE == iran ]] || die "run add-rule on the IRAN server; KHAREJ is the destination"
  local protocol=${1:-} source_port=${2:-} destination_port=${3:-}
  if [[ -z $protocol ]] && command -v whiptail >/dev/null 2>&1; then
    protocol=$(whiptail --title "RIZAY - Protocol" --menu "Choose protocol" 13 54 2 \
      tcp "TCP" udp "UDP" 3>&1 1>&2 2>&3) || die "cancelled"
  fi
  [[ -n $protocol ]] || read -r -p "Protocol (tcp/udp): " protocol
  [[ -n $source_port ]] || source_port=$(ui_input "RIZAY - IRAN port" "Port users connect to on the IRAN server:" "")
  [[ -n $destination_port ]] || destination_port=$(ui_input "RIZAY - KHAREJ port" "Final service port on the KHAREJ server:" "$source_port")
  valid_protocol "$protocol" || die "protocol must be tcp or udp"
  valid_port "$source_port" || die "public port must be 1-65535"
  valid_port "$destination_port" || die "KHAREJ port must be 1-65535"
  install -d -m 700 "$CONFIG_DIR"
  touch "$RULES_FILE"
  chmod 600 "$RULES_FILE"
  if awk -v p="$protocol" -v s="$source_port" \
    '$1 == p && $2 == s { found=1 } END { exit !found }' "$RULES_FILE"; then
    die "this protocol/public-port pair already has a rule"
  fi
  apply_rule "$protocol" "$source_port" "$destination_port"
  printf '%s %s %s\n' "$protocol" "$source_port" "$destination_port" >> "$RULES_FILE"
  ui_message "RIZAY - Rule added" "$protocol/$source_port on IRAN now forwards to $GRE_REMOTE:$destination_port on KHAREJ."
}

list_rules() {
  require_root list-rules
  load_config || die "not configured; run: sudo gre-manager wizard"
  if [[ ! -s $RULES_FILE ]]; then info "No saved rules."; return; fi
  printf '%-8s %-14s %s\n' PROTOCOL IRAN_PORT KHAREJ_PORT
  awk '!/^($|#)/ { printf "%-8s %-14s %s\\n", $1, $2, $3 }' "$RULES_FILE"
}

clear_rules() {
  require_root clear-rules
  load_config || true
  remove_runtime_rules
  rm -f -- "$RULES_FILE"
  info "All IRAN-to-KHAREJ forwarding rules cleared."
}

ping_stats() {
  local target=$1 samples=$2 output timing
  output=$(LC_ALL=C ping -n -q -c "$samples" -i 0.2 -W 2 "$target" 2>&1 || true)
  PING_LOSS=$(printf '%s\n' "$output" | sed -n 's/.* \([0-9.]*\)% packet loss.*/\1/p' | head -n 1)
  [[ $PING_LOSS =~ ^[0-9]+([.][0-9]+)?$ ]] || PING_LOSS="100"
  timing=$(printf '%s\n' "$output" | awk -F' = ' '/^(rtt|round-trip)/ { split($2,a,"/"); print a[1],a[2],a[3]; exit }')
  PING_MIN="-"; PING_AVG="-"; PING_MAX="-"
  [[ -z $timing ]] || read -r PING_MIN PING_AVG PING_MAX <<< "$timing"
}

health() {
  require_root health
  load_config || die "not configured; run: sudo gre-manager wizard"
  require_command ping
  local samples=${1:-50} public_loss public_min public_avg public_max
  local gre_loss gre_min gre_avg gre_max tunnel_up=0 forward_on=0 score label
  local tunnel_text="DOWN" forward_text="OFF"
  valid_samples "$samples" || die "sample count must be between 5 and 200"
  banner
  info "Measuring both paths with $samples packets each; please wait..."
  ping_stats "$REMOTE_IP" "$samples"
  public_loss=${PING_LOSS%.*}; public_min=$PING_MIN; public_avg=$PING_AVG; public_max=$PING_MAX
  if ip link show "$IFACE" 2>/dev/null | grep -q 'UP'; then tunnel_up=1; tunnel_text="UP"; fi
  ping_stats "$GRE_REMOTE" "$samples"
  gre_loss=${PING_LOSS%.*}; gre_min=$PING_MIN; gre_avg=$PING_AVG; gre_max=$PING_MAX
  if [[ $(sysctl -n net.ipv4.ip_forward 2>/dev/null || true) == 1 ]]; then forward_on=1; forward_text="ON"; fi

  if (( gre_loss < 100 )); then
    score=$((100 - (gre_loss * 80 / 100)))
  else
    score=$((50 - (public_loss * 30 / 100)))
    (( tunnel_up == 1 )) || score=$((score - 20))
  fi
  (( forward_on == 1 )) || score=$((score - 10))
  (( score < 0 )) && score=0
  (( score > 100 )) && score=100
  if (( score >= 90 )); then label="Excellent"; elif (( score >= 70 )); then label="Good"; elif (( score >= 45 )); then label="Unstable"; else label="Not ready"; fi

  printf '\nRole                  : %s\n' "${ROLE^^}"
  printf 'IRAN public IP        : %s\n' "$IRAN_IP"
  printf 'KHAREJ public IP      : %s\n' "$KHAREJ_IP"
  printf 'Public path loss      : %s%%  (RTT min/avg/max: %s/%s/%s ms)\n' "$public_loss" "$public_min" "$public_avg" "$public_max"
  printf 'GRE path loss         : %s%%  (RTT min/avg/max: %s/%s/%s ms)\n' "$gre_loss" "$gre_min" "$gre_avg" "$gre_max"
  printf 'GRE interface         : %s\n' "$tunnel_text"
  printf 'IPv4 forwarding       : %s\n' "$forward_text"
  printf '\nEstimated readiness   : %s%% â€” %s\n' "$score" "$label"
  printf 'Note: this is a diagnostic score, not a guaranteed statistical probability.\n'
  printf 'Run this test on BOTH servers for a true two-sided comparison.\n'
  (( score >= 45 ))
}

status() {
  require_root status
  load_config || die "not configured; run: sudo gre-manager wizard"
  banner
  printf 'Role: %s | IRAN: %s | KHAREJ: %s\n' "${ROLE^^}" "$IRAN_IP" "$KHAREJ_IP"
  if ip link show "$IFACE" >/dev/null 2>&1; then
    ip -brief address show "$IFACE"
  else
    info "GRE tunnel: stopped"
    return 1
  fi
}

menu() {
  require_root menu
  local choice
  while true; do
    clear 2>/dev/null || true
    banner
    if command -v whiptail >/dev/null 2>&1; then
      choice=$(whiptail --title "RIZAY GRE Manager v$VERSION" --menu "Choose an action" 20 76 9 \
        health "Packet loss + tunnel readiness" \
        wizard "Graphical setup wizard" \
        add "Forward a port: IRAN -> KHAREJ" \
        rules "List saved forwarding rules" \
        status "Show tunnel status" \
        restart "Restart GRE tunnel" \
        clear "Clear forwarding rules" \
        stop "Stop GRE tunnel" \
        exit "Exit" 3>&1 1>&2 2>&3) || return 0
    else
      printf '1) Health  2) Setup  3) Add rule  4) Rules  5) Status\n6) Restart 7) Clear  8) Stop      9) Exit\n'
      read -r -p "Choice: " choice
      case "$choice" in 1) choice=health;; 2) choice=wizard;; 3) choice=add;; 4) choice=rules;; 5) choice=status;; 6) choice=restart;; 7) choice=clear;; 8) choice=stop;; 9) choice=exit;; esac
    fi
    case "$choice" in
      health) health 50 || true ;; wizard) wizard ;; add) add_rule ;; rules) list_rules ;;
      status) status || true ;; restart) stop_tunnel; start_tunnel ;; clear) clear_rules ;;
      stop) stop_tunnel ;; exit) return 0 ;; *) info "Invalid choice." ;;
    esac
    [[ $choice == wizard ]] || { printf '\nPress Enter to continue...'; read -r _; }
  done
}

usage() {
  cat <<'EOF'
RIZAY GRE Manager - IRAN to KHAREJ tunnel and port forwarding

Usage: gre-manager COMMAND [ARGS]
  wizard                     Graphical IRAN/KHAREJ setup
  health [5-200]             Measure public/GRE loss and readiness (default: 50)
  start|stop|restart         Control the tunnel
  status                     Show role, endpoints and tunnel state
  add-rule [tcp|udp SRC DST] Forward an IRAN port to the KHAREJ server
  list-rules                 List persistent forwarding rules
  clear-rules                Remove all forwarding rules
  menu                       Open the graphical management menu
  version                    Print version
  help                       Show this help
EOF
}

case "${1:-menu}" in
  wizard|configure) wizard ;; health) shift; health "${1:-50}" ;;
  start) start_tunnel ;; stop) stop_tunnel ;; restart) stop_tunnel; start_tunnel ;;
  status) status ;; add-rule) shift; add_rule "$@" ;; list-rules) list_rules ;;
  clear-rules) clear_rules ;; menu) menu ;; version|--version|-v) info "$VERSION" ;;
  help|--help|-h) usage ;; *) usage >&2; exit 2 ;;
esac


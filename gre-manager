#!/usr/bin/env bash
set -Eeuo pipefail

readonly VERSION="5.0.0"
readonly CONFIG_DIR="/etc/gre-manager"
readonly CONFIG_FILE="$CONFIG_DIR/config.conf"
readonly RULES_FILE="$CONFIG_DIR/rules.conf"
readonly GOST_RULES_FILE="$CONFIG_DIR/gost-rules.conf"
readonly GOST_CONFIG_FILE="$CONFIG_DIR/gost.yaml"
readonly GOST_BIN="/usr/local/lib/gre-manager/gost"
readonly GOST_SERVICE="rizay-gost.service"
readonly GOST_VERSION="3.3.0"
readonly OPTIMIZE_FILE="/etc/sysctl.d/99-rizay-tunnel.conf"
readonly IFACE="gre-manager"
readonly NAT_CHAIN="GRE_MANAGER_NAT"
readonly FWD_CHAIN="GRE_MANAGER_FWD"
readonly LOCK_FILE="${GRE_MANAGER_LOCK_FILE:-/run/lock/gre-manager.lock}"

ROLE=""
MODE="hybrid"
IRAN_IP=""
KHAREJ_IP=""
LOCAL_IP=""
REMOTE_IP=""
GRE_LOCAL=""
GRE_REMOTE=""
GRE_PREFIX="30"
MTU="1400"
PUBLIC_IFACE=""
PING_LOSS="100"
PING_MIN="-"
PING_AVG="-"
PING_MAX="-"
PING_MDEV="-"
LOCK_HELD=0
DOCTOR_PASS=0
DOCTOR_WARN=0
DOCTOR_FAIL=0

export NEWT_COLORS='
root=white,blue
border=brightblue,blue
window=white,blue
shadow=black,black
title=brightcyan,blue
button=blue,white
actbutton=white,cyan
compactbutton=white,blue
checkbox=white,blue
actcheckbox=white,cyan
entry=white,blue
label=white,blue
listbox=white,blue
actlistbox=white,cyan
textbox=white,blue
acttextbox=white,cyan
helpline=brightcyan,blue
roottext=white,blue
'

die() { printf 'Error: %s\n' "$*" >&2; exit 1; }
info() { printf '%s\n' "$*"; }
require_root() { [[ ${EUID:-$(id -u)} -eq 0 ]] || die "run with sudo: sudo gre-manager $*"; }
require_command() { command -v "$1" >/dev/null 2>&1 || die "required command not found: $1"; }

acquire_lock() {
  (( LOCK_HELD == 1 )) && return 0
  require_command flock
  install -d -m 755 "$(dirname "$LOCK_FILE")"
  exec 9>"$LOCK_FILE"
  flock -w 10 9 || die "another GRE Manager operation is still running"
  LOCK_HELD=1
}

ipt() { iptables -w 5 "$@"; }

banner() {
  local border='' blue='' accent='' reset=''
  if [[ -t 1 ]]; then
    border='\033[38;5;27m'
    blue='\033[1;94m'
    accent='\033[1;96m'
    reset='\033[0m'
  fi
  printf '%b%s%b\n' "$border" '................................................................................' "$reset"
  printf '%b' "$blue"
  cat <<'EOF'
.............  ...........  .............       ...       ...         ...
...       ...      ...              ...        .....      ...         ...
...       ...      ...             ...        ... ...      ...       ...
.............      ...            ...        ...   ...      ...     ...
...   ...          ...          ....        ...     ...      ...   ...
...    ...         ...        ....         .............      .......
...     ...        ...       ...           ...       ...        ...
...      ...       ...      ...            ...       ...        ...
...       ...  ...........  .............  ...       ...        ...
EOF
  printf '%b' "$reset"
  printf '%b%48s%b\n' "$accent" 'RIZAY GRE MANAGER' "$reset"
  printf '%b%44s v%s%b\n' "$border" 'VERSION' "$VERSION" "$reset"
  printf '%b%s%b\n\n' "$border" '................................................................................' "$reset"
}

valid_ipv4() {
  local ip=$1 IFS=. octets i
  [[ $ip =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ ]] || return 1
  read -r -a octets <<< "$ip"
  for i in "${octets[@]}"; do
    [[ $i =~ ^[0-9]{1,3}$ && 10#$i -le 255 ]] || return 1
  done
}

valid_port() { [[ $1 =~ ^[0-9]+$ && 10#$1 -ge 1 && 10#$1 -le 65535 ]]; }
valid_mtu() { [[ $1 =~ ^[0-9]+$ && 10#$1 -ge 576 && 10#$1 -le 9000 ]]; }
valid_protocol() { [[ $1 == tcp || $1 == udp ]]; }
valid_mode() { [[ $1 == hybrid || $1 == gre || $1 == gost ]]; }
valid_transport() { [[ $1 == public || $1 == gre ]]; }
valid_samples() { [[ $1 =~ ^[0-9]+$ && 10#$1 -ge 5 && 10#$1 -le 200 ]]; }

derive_endpoints() {
  case "$ROLE" in
    iran)
      LOCAL_IP=$IRAN_IP
      REMOTE_IP=$KHAREJ_IP
      GRE_LOCAL="10.77.0.1"
      GRE_REMOTE="10.77.0.2"
      ;;
    kharej)
      LOCAL_IP=$KHAREJ_IP
      REMOTE_IP=$IRAN_IP
      GRE_LOCAL="10.77.0.2"
      GRE_REMOTE="10.77.0.1"
      ;;
    *) die "invalid server role; run: sudo gre-manager wizard" ;;
  esac
}

validate_config() {
  [[ $ROLE == iran || $ROLE == kharej ]] || die "role must be IRAN or KHAREJ"
  valid_mode "$MODE" || die "mode must be HYBRID, GRE or GOST"
  valid_ipv4 "$IRAN_IP" || die "invalid IRAN public IPv4 address"
  valid_ipv4 "$KHAREJ_IP" || die "invalid KHAREJ public IPv4 address"
  [[ $IRAN_IP != "$KHAREJ_IP" ]] || die "IRAN and KHAREJ IPs must be different"
  valid_mtu "$MTU" || die "MTU must be between 576 and 9000"
  derive_endpoints
}

load_config() {
  [[ -r $CONFIG_FILE ]] || return 1
  local key value
  while IFS='=' read -r key value; do
    case "$key" in
      ROLE) ROLE=$value ;;
      MODE) MODE=$value ;;
      IRAN_IP) IRAN_IP=$value ;;
      KHAREJ_IP) KHAREJ_IP=$value ;;
      MTU) MTU=$value ;;
    esac
  done < "$CONFIG_FILE"
  validate_config
}

save_config() {
  validate_config
  acquire_lock
  install -d -m 700 "$CONFIG_DIR"
  local tmp
  tmp=$(mktemp "$CONFIG_DIR/config.XXXXXX")
  chmod 600 "$tmp"
  printf 'ROLE=%s\nMODE=%s\nIRAN_IP=%s\nKHAREJ_IP=%s\nMTU=%s\n' \
    "$ROLE" "$MODE" "$IRAN_IP" "$KHAREJ_IP" "$MTU" > "$tmp"
  mv -f "$tmp" "$CONFIG_FILE"
}

ui_input() {
  local title=$1 prompt=$2 default_value=${3:-} result
  if command -v whiptail >/dev/null 2>&1; then
    result=$(whiptail --title "$title" --inputbox "$prompt" 10 72 "$default_value" 3>&1 1>&2 2>&3) || return 1
    printf '%s' "$result"
  else
    read -r -p "$prompt [$default_value]: " result
    printf '%s' "${result:-$default_value}"
  fi
}

ui_message() {
  local title=$1 message=$2
  if command -v whiptail >/dev/null 2>&1; then
    whiptail --title "$title" --msgbox "$message" 14 76
  else
    printf '\n%s\n%s\n\n' "$title" "$message"
  fi
}

wizard() {
  require_root wizard
  local role_choice mode_choice
  clear 2>/dev/null || true
  banner
  if command -v whiptail >/dev/null 2>&1; then
    role_choice=$(whiptail --title "RIZAY v$VERSION - Server role" \
      --menu "This setup runs on both servers. Which server is this?" 16 78 2 \
      IRAN "Gateway - receives users and forwards ports" \
      KHAREJ "Destination - runs the final services" \
      3>&1 1>&2 2>&3) || die "setup cancelled"
    ROLE=${role_choice,,}
  else
    read -r -p "Server role (IRAN/KHAREJ): " ROLE
    ROLE=${ROLE,,}
  fi
  if command -v whiptail >/dev/null 2>&1; then
    mode_choice=$(whiptail --title "RIZAY v$VERSION - Tunnel engine" \
      --menu "Choose the tunnel stack. HYBRID is recommended." 17 78 3 \
      HYBRID "GRE + GOST forwarding (recommended)" \
      GRE "GRE tunnel and iptables forwarding only" \
      GOST "GOST forwarding only (configured on IRAN)" \
      3>&1 1>&2 2>&3) || die "setup cancelled"
    MODE=${mode_choice,,}
  else
    read -r -p "Tunnel mode (HYBRID/GRE/GOST) [HYBRID]: " MODE
    MODE=${MODE:-hybrid}
    MODE=${MODE,,}
  fi
  while true; do
    IRAN_IP=$(ui_input "RIZAY - IRAN endpoint" "Public IPv4 of the IRAN server:" "$IRAN_IP") || die "setup cancelled"
    valid_ipv4 "$IRAN_IP" && break
    ui_message "RIZAY - Invalid IP" "Enter a valid public IPv4 for IRAN. Example: 203.0.113.10"
  done
  while true; do
    KHAREJ_IP=$(ui_input "RIZAY - KHAREJ endpoint" "Public IPv4 of the KHAREJ destination server:" "$KHAREJ_IP") || die "setup cancelled"
    if valid_ipv4 "$KHAREJ_IP" && [[ $KHAREJ_IP != "$IRAN_IP" ]]; then break; fi
    ui_message "RIZAY - Invalid IP" "Enter a valid KHAREJ IPv4 different from the IRAN IP."
  done
  while true; do
    MTU=$(ui_input "RIZAY - MTU" "Tunnel MTU (1400 is recommended):" "${MTU:-1400}") || die "setup cancelled"
    valid_mtu "$MTU" && break
    ui_message "RIZAY - Invalid MTU" "MTU must be a number between 576 and 9000."
  done
  validate_config

  local role_text summary
  if [[ $ROLE == iran ]]; then role_text="IRAN gateway / port-forward source"; else role_text="KHAREJ destination"; fi
  summary="Role: $role_text
Mode: ${MODE^^}
IRAN public IP: $IRAN_IP
KHAREJ public IP: $KHAREJ_IP
Local GRE IP: $GRE_LOCAL/$GRE_PREFIX
Remote GRE IP: $GRE_REMOTE
MTU: $MTU"
  if command -v whiptail >/dev/null 2>&1; then
    whiptail --title "RIZAY - Confirm configuration" --yesno "$summary" 17 76 || die "setup cancelled"
  else
    printf '\n%s\n' "$summary"
  fi

  save_config
  if [[ $MODE != gost ]]; then start_tunnel; fi
  command -v systemctl >/dev/null 2>&1 && systemctl enable gre-manager.service >/dev/null 2>&1 || true
  clear 2>/dev/null || true
  banner
  info "$summary"
  if [[ $ROLE == iran && $MODE != gre ]]; then
    info ""
    info "GOST is ready for its first rule:"
    info "  sudo gre-manager add-gost tcp IRAN_PORT KHAREJ_PORT public"
  elif [[ $ROLE == iran ]]; then
    info ""
    info "IRAN gateway is ready. Add a forward with:"
    info "  sudo gre-manager add-rule tcp IRAN_PORT KHAREJ_PORT"
  else
    info ""
    info "KHAREJ destination is ready. Configure the IRAN server next."
  fi
  info ""
  if [[ $ROLE == iran && $MODE != gre ]] && command -v whiptail >/dev/null 2>&1; then
    if whiptail --title "RIZAY - First GOST rule" --yesno \
      "HYBRID setup is ready. Do you want to add the first GOST port now?" 11 72; then
      add_gost_rule
    fi
  fi
  health 20 || true
}

detect_public_iface() {
  PUBLIC_IFACE=$(ip route show default 2>/dev/null | awk 'NR == 1 { print $5 }')
  [[ -n $PUBLIC_IFACE ]] || die "could not detect the public network interface"
}

remove_runtime_rules() {
  while ipt -t nat -C PREROUTING -j "$NAT_CHAIN" 2>/dev/null; do ipt -t nat -D PREROUTING -j "$NAT_CHAIN"; done
  while ipt -C FORWARD -j "$FWD_CHAIN" 2>/dev/null; do ipt -D FORWARD -j "$FWD_CHAIN"; done
  while ipt -t nat -C POSTROUTING -o "$IFACE" -j MASQUERADE 2>/dev/null; do
    ipt -t nat -D POSTROUTING -o "$IFACE" -j MASQUERADE
  done
  ipt -t nat -F "$NAT_CHAIN" 2>/dev/null || true
  ipt -F "$FWD_CHAIN" 2>/dev/null || true
  ipt -t nat -X "$NAT_CHAIN" 2>/dev/null || true
  ipt -X "$FWD_CHAIN" 2>/dev/null || true
}

ensure_runtime_chains() {
  [[ $ROLE == iran ]] || return 0
  [[ -n $PUBLIC_IFACE ]] || detect_public_iface
  ipt -t nat -N "$NAT_CHAIN" 2>/dev/null || true
  ipt -N "$FWD_CHAIN" 2>/dev/null || true
  ipt -t nat -C PREROUTING -j "$NAT_CHAIN" 2>/dev/null || ipt -t nat -A PREROUTING -j "$NAT_CHAIN"
  ipt -C FORWARD -j "$FWD_CHAIN" 2>/dev/null || ipt -A FORWARD -j "$FWD_CHAIN"
  ipt -t nat -C POSTROUTING -o "$IFACE" -j MASQUERADE 2>/dev/null || \
    ipt -t nat -A POSTROUTING -o "$IFACE" -j MASQUERADE
  ipt -C "$FWD_CHAIN" -i "$IFACE" -o "$PUBLIC_IFACE" -m conntrack \
    --ctstate ESTABLISHED,RELATED -j ACCEPT 2>/dev/null || \
    ipt -A "$FWD_CHAIN" -i "$IFACE" -o "$PUBLIC_IFACE" -m conntrack \
      --ctstate ESTABLISHED,RELATED -j ACCEPT
}

apply_rule() {
  local protocol=$1 source_port=$2 destination_port=$3
  [[ $ROLE == iran ]] || die "port forwarding must be configured on the IRAN gateway"
  valid_protocol "$protocol" || die "invalid protocol in rules file: $protocol"
  valid_port "$source_port" || die "invalid public port in rules file: $source_port"
  valid_port "$destination_port" || die "invalid KHAREJ port in rules file: $destination_port"
  ensure_runtime_chains
  ipt -t nat -C "$NAT_CHAIN" -i "$PUBLIC_IFACE" -p "$protocol" --dport "$source_port" \
    -j DNAT --to-destination "$GRE_REMOTE:$destination_port" 2>/dev/null || \
    ipt -t nat -A "$NAT_CHAIN" -i "$PUBLIC_IFACE" -p "$protocol" --dport "$source_port" \
      -j DNAT --to-destination "$GRE_REMOTE:$destination_port"
  ipt -C "$FWD_CHAIN" -i "$PUBLIC_IFACE" -o "$IFACE" -p "$protocol" \
    -d "$GRE_REMOTE" --dport "$destination_port" -j ACCEPT 2>/dev/null || \
    ipt -A "$FWD_CHAIN" -i "$PUBLIC_IFACE" -o "$IFACE" -p "$protocol" \
      -d "$GRE_REMOTE" --dport "$destination_port" -j ACCEPT
}

apply_saved_rules() {
  [[ $ROLE == iran && -s $RULES_FILE ]] || return 0
  local protocol source_port destination_port extra
  while read -r protocol source_port destination_port extra; do
    [[ -z ${protocol:-} || $protocol == \#* ]] && continue
    [[ -z ${extra:-} ]] || die "malformed rule in $RULES_FILE"
    apply_rule "$protocol" "$source_port" "$destination_port"
  done < "$RULES_FILE"
}

start_tunnel() {
  require_root start
  for command_name in ip iptables modprobe sysctl; do require_command "$command_name"; done
  acquire_lock
  load_config || die "not configured; run: sudo gre-manager wizard"
  [[ $MODE != gost ]] || { info "GRE engine is disabled in GOST mode."; return 0; }
  detect_public_iface
  modprobe ip_gre
  ip tunnel del "$IFACE" 2>/dev/null || true
  ip tunnel add "$IFACE" mode gre local "$LOCAL_IP" remote "$REMOTE_IP" ttl 255
  ip address add "$GRE_LOCAL/$GRE_PREFIX" dev "$IFACE"
  ip link set "$IFACE" mtu "$MTU" up
  sysctl -q -w net.ipv4.ip_forward=1
  remove_runtime_rules
  apply_saved_rules
  info "GRE tunnel started: $GRE_LOCAL -> $GRE_REMOTE (${ROLE^^})"
}

stop_tunnel() {
  require_root stop
  acquire_lock
  remove_runtime_rules
  ip tunnel del "$IFACE" 2>/dev/null || true
  info "GRE tunnel stopped."
}

start_stack() {
  require_root start
  load_config || die "not configured; run: sudo gre-manager wizard"
  if [[ $MODE != gost ]]; then start_tunnel; else info "GRE is disabled in GOST mode."; fi
  if [[ $ROLE == iran && $MODE != gre && -s $GOST_RULES_FILE ]]; then sync_gost; fi
}

stop_stack() {
  require_root stop
  load_config || true
  if [[ $MODE != gost ]]; then stop_tunnel; fi
  if command -v systemctl >/dev/null 2>&1; then systemctl stop "$GOST_SERVICE" >/dev/null 2>&1 || true; fi
  info "RIZAY tunnel stack stopped."
}

restart_stack() {
  require_root restart
  load_config || die "not configured; run: sudo gre-manager wizard"
  if [[ $MODE != gost ]]; then stop_tunnel; start_tunnel; fi
  if [[ $ROLE == iran && $MODE != gre && -s $GOST_RULES_FILE ]]; then sync_gost; fi
  info "RIZAY tunnel stack restarted."
}

add_rule() {
  require_root add-rule
  load_config || die "not configured; run: sudo gre-manager wizard"
  [[ $ROLE == iran ]] || die "run add-rule on the IRAN server; KHAREJ is the destination"
  [[ $MODE != gost ]] || die "GRE rules are disabled in GOST mode; use add-gost or rerun wizard with HYBRID"
  local protocol=${1:-} source_port=${2:-} destination_port=${3:-} tmp
  if [[ -z $protocol ]] && command -v whiptail >/dev/null 2>&1; then
    protocol=$(whiptail --title "RIZAY - Protocol" --menu "Choose protocol" 13 54 2 \
      tcp "TCP" udp "UDP" 3>&1 1>&2 2>&3) || die "cancelled"
  fi
  [[ -n $protocol ]] || read -r -p "Protocol (tcp/udp): " protocol
  [[ -n $source_port ]] || source_port=$(ui_input "RIZAY - IRAN port" "Port users connect to on the IRAN server:" "")
  [[ -n $destination_port ]] || destination_port=$(ui_input "RIZAY - KHAREJ port" "Final service port on the KHAREJ server:" "$source_port")
  valid_protocol "$protocol" || die "protocol must be tcp or udp"
  valid_port "$source_port" || die "public port must be 1-65535"
  valid_port "$destination_port" || die "KHAREJ port must be 1-65535"
  acquire_lock
  install -d -m 700 "$CONFIG_DIR"
  touch "$RULES_FILE"
  chmod 600 "$RULES_FILE"
  if awk -v p="$protocol" -v s="$source_port" \
    '$1 == p && $2 == s { found=1 } END { exit !found }' "$RULES_FILE"; then
    die "this protocol/public-port pair already has a rule"
  fi
  apply_rule "$protocol" "$source_port" "$destination_port"
  tmp=$(mktemp "$CONFIG_DIR/rules.XXXXXX")
  [[ ! -f $RULES_FILE ]] || cat "$RULES_FILE" > "$tmp"
  printf '%s %s %s\n' "$protocol" "$source_port" "$destination_port" >> "$tmp"
  chmod 600 "$tmp"
  mv -f "$tmp" "$RULES_FILE"
  ui_message "RIZAY - Rule added" "$protocol/$source_port on IRAN now forwards to $GRE_REMOTE:$destination_port on KHAREJ."
}

remove_rule() {
  require_root remove-rule
  load_config || die "not configured; run: sudo gre-manager wizard"
  [[ $ROLE == iran ]] || die "rules are managed on the IRAN server"
  local protocol=${1:-} source_port=${2:-} tmp
  if [[ -z $protocol ]] && command -v whiptail >/dev/null 2>&1; then
    protocol=$(whiptail --title "RIZAY - Protocol" --menu "Rule protocol" 13 54 2 \
      tcp "TCP" udp "UDP" 3>&1 1>&2 2>&3) || die "cancelled"
  fi
  [[ -n $protocol ]] || read -r -p "Protocol (tcp/udp): " protocol
  [[ -n $source_port ]] || source_port=$(ui_input "RIZAY - Remove rule" "IRAN public port to remove:" "")
  valid_protocol "$protocol" || die "protocol must be tcp or udp"
  valid_port "$source_port" || die "IRAN port must be 1-65535"
  [[ -s $RULES_FILE ]] || die "no saved rules"
  acquire_lock
  if ! awk -v p="$protocol" -v s="$source_port" \
    '$1 == p && $2 == s { found=1 } END { exit !found }' "$RULES_FILE"; then
    die "rule not found: $protocol/$source_port"
  fi
  tmp=$(mktemp "$CONFIG_DIR/rules.XXXXXX")
  awk -v p="$protocol" -v s="$source_port" '!($1 == p && $2 == s)' "$RULES_FILE" > "$tmp"
  chmod 600 "$tmp"
  if [[ -s $tmp ]]; then mv -f "$tmp" "$RULES_FILE"; else rm -f -- "$tmp" "$RULES_FILE"; fi
  remove_runtime_rules
  apply_saved_rules
  ui_message "RIZAY - Rule removed" "$protocol/$source_port was removed and the firewall was rebuilt."
}

list_rules() {
  require_root list-rules
  load_config || die "not configured; run: sudo gre-manager wizard"
  if [[ ! -s $RULES_FILE ]]; then info "No saved rules."; return; fi
  printf '%-8s %-14s %s\n' PROTOCOL IRAN_PORT KHAREJ_PORT
  awk '!/^($|#)/ { printf "%-8s %-14s %s\\n", $1, $2, $3 }' "$RULES_FILE"
}

clear_rules() {
  require_root clear-rules
  load_config || true
  acquire_lock
  remove_runtime_rules
  rm -f -- "$RULES_FILE"
  info "All IRAN-to-KHAREJ forwarding rules cleared."
}

gost_arch() {
  case "$(uname -m)" in
    x86_64|amd64) printf 'amd64' ;;
    i386|i486|i586|i686) printf '386' ;;
    aarch64|arm64) printf 'arm64' ;;
    armv7l|armv7) printf 'armv7' ;;
    *) die "GOST does not have a supported build for architecture: $(uname -m)" ;;
  esac
}

install_gost_binary() {
  require_root install-gost
  local force=${1:-} current="" arch asset base work_dir
  if [[ -x $GOST_BIN ]]; then current=$($GOST_BIN -V 2>&1 || true); fi
  if [[ $force != --force && $current == *"$GOST_VERSION"* ]]; then
    info "GOST $GOST_VERSION is already installed for RIZAY."
    return 0
  fi
  for command_name in curl tar sha256sum awk; do require_command "$command_name"; done
  arch=$(gost_arch)
  asset="gost_${GOST_VERSION}_linux_${arch}.tar.gz"
  base="https://github.com/go-gost/gost/releases/download/v${GOST_VERSION}"
  work_dir=$(mktemp -d /tmp/rizay-gost.XXXXXX)
  (
    set -Eeuo pipefail
    trap 'rm -rf -- "$work_dir"' EXIT
    info "Downloading official GOST v$GOST_VERSION ($arch)..."
    curl --proto '=https' --tlsv1.2 -fL "$base/$asset" -o "$work_dir/$asset"
    curl --proto '=https' --tlsv1.2 -fL "$base/checksums.txt" -o "$work_dir/checksums.txt"
    awk -v file="$asset" '$2 == file || $2 == "*" file { print $1 "  " file; found=1 } END { exit !found }' \
      "$work_dir/checksums.txt" > "$work_dir/selected.sha256"
    cd "$work_dir"
    sha256sum -c selected.sha256
    install -d -m 755 "$work_dir/unpack" /usr/local/lib/gre-manager
    tar -xzf "$asset" -C "$work_dir/unpack"
    [[ -f $work_dir/unpack/gost ]] || die "official GOST archive did not contain the expected binary"
    install -m 755 "$work_dir/unpack/gost" "$GOST_BIN"
  )
  "$GOST_BIN" -V
}

gost_target() {
  local transport=$1
  case "$transport" in
    public) printf '%s' "$KHAREJ_IP" ;;
    gre) printf '%s' "$GRE_REMOTE" ;;
    *) die "invalid GOST transport: $transport" ;;
  esac
}

write_gost_config() {
  local tmp protocol source_port destination_port transport extra target count=0
  install -d -m 700 "$CONFIG_DIR"
  tmp=$(mktemp "$CONFIG_DIR/gost.XXXXXX")
  chmod 600 "$tmp"
  printf 'services:\n' > "$tmp"
  while read -r protocol source_port destination_port transport extra; do
    [[ -z ${protocol:-} || $protocol == \#* ]] && continue
    [[ -z ${extra:-} ]] || die "malformed rule in $GOST_RULES_FILE"
    valid_protocol "$protocol" || die "invalid GOST protocol: $protocol"
    valid_port "$source_port" || die "invalid GOST IRAN port: $source_port"
    valid_port "$destination_port" || die "invalid GOST KHAREJ port: $destination_port"
    valid_transport "$transport" || die "invalid GOST transport: $transport"
    target=$(gost_target "$transport")
    cat >> "$tmp" <<EOF
- name: rizay-${protocol}-${source_port}
  addr: ":${source_port}"
  handler:
    type: ${protocol}
  listener:
    type: ${protocol}
  forwarder:
    nodes:
    - name: kharej-${protocol}-${destination_port}
      addr: "${target}:${destination_port}"
EOF
    ((count+=1))
  done < "$GOST_RULES_FILE"
  (( count > 0 )) || { rm -f -- "$tmp"; die "no valid GOST rules to render"; }
  mv -f "$tmp" "$GOST_CONFIG_FILE"
}

sync_gost() {
  require_root sync-gost
  load_config || die "not configured; run: sudo gre-manager wizard"
  [[ $ROLE == iran ]] || die "GOST forwarding is managed on the IRAN server"
  acquire_lock
  if [[ ! -s $GOST_RULES_FILE ]]; then
    rm -f -- "$GOST_CONFIG_FILE"
    if command -v systemctl >/dev/null 2>&1; then systemctl disable --now "$GOST_SERVICE" >/dev/null 2>&1 || true; fi
    info "No GOST rules. The RIZAY GOST service is disabled."
    return 0
  fi
  install_gost_binary
  write_gost_config
  systemctl daemon-reload
  systemctl enable "$GOST_SERVICE" >/dev/null
  if systemctl restart "$GOST_SERVICE"; then
    info "GOST service rebuilt from saved rules."
  else
    systemctl --no-pager --full status "$GOST_SERVICE" || true
    die "GOST could not start; another service may already use a configured IRAN port"
  fi
}

add_gost_rule() {
  require_root add-gost
  load_config || die "not configured; run: sudo gre-manager wizard"
  [[ $ROLE == iran ]] || die "run add-gost on IRAN; KHAREJ is the destination"
  local protocol=${1:-} source_port=${2:-} destination_port=${3:-} transport=${4:-} tmp
  if [[ -z $protocol ]] && command -v whiptail >/dev/null 2>&1; then
    protocol=$(whiptail --title "RIZAY - GOST protocol" --menu "Choose listener protocol" 13 58 2 \
      tcp "TCP forwarding" udp "UDP forwarding" 3>&1 1>&2 2>&3) || die "cancelled"
  fi
  [[ -n $protocol ]] || read -r -p "Protocol (tcp/udp): " protocol
  [[ -n $source_port ]] || source_port=$(ui_input "RIZAY - GOST IRAN port" "Port users connect to on IRAN:" "")
  [[ -n $destination_port ]] || destination_port=$(ui_input "RIZAY - GOST KHAREJ port" "Final service port on KHAREJ:" "$source_port")
  if [[ -z $transport ]] && command -v whiptail >/dev/null 2>&1; then
    transport=$(whiptail --title "RIZAY - GOST path" --menu "Choose the path to KHAREJ" 15 72 2 \
      public "Direct public IP (independent from GRE)" \
      gre "Inside GRE (private 10.77.0.x path)" 3>&1 1>&2 2>&3) || die "cancelled"
  fi
  transport=${transport:-public}
  valid_protocol "$protocol" || die "protocol must be tcp or udp"
  valid_port "$source_port" || die "IRAN port must be 1-65535"
  valid_port "$destination_port" || die "KHAREJ port must be 1-65535"
  valid_transport "$transport" || die "path must be public or gre"
  [[ $transport != gre || $MODE != gost ]] || die "GRE path requires HYBRID or GRE mode"
  acquire_lock
  install -d -m 700 "$CONFIG_DIR"
  touch "$GOST_RULES_FILE"
  chmod 600 "$GOST_RULES_FILE"
  if awk -v p="$protocol" -v s="$source_port" \
    '$1 == p && $2 == s { found=1 } END { exit !found }' "$GOST_RULES_FILE"; then
    die "this GOST protocol/IRAN-port pair already exists"
  fi
  tmp=$(mktemp "$CONFIG_DIR/gost-rules.XXXXXX")
  cat "$GOST_RULES_FILE" > "$tmp"
  printf '%s %s %s %s\n' "$protocol" "$source_port" "$destination_port" "$transport" >> "$tmp"
  chmod 600 "$tmp"
  mv -f "$tmp" "$GOST_RULES_FILE"
  if [[ $MODE == gre ]]; then MODE=hybrid; save_config; fi
  sync_gost
  ui_message "RIZAY - GOST rule added" "$protocol/$source_port on IRAN now forwards through ${transport^^} to KHAREJ port $destination_port."
}

remove_gost_rule() {
  require_root remove-gost
  load_config || die "not configured; run: sudo gre-manager wizard"
  [[ $ROLE == iran ]] || die "GOST rules are managed on IRAN"
  local protocol=${1:-} source_port=${2:-} tmp
  if [[ -z $protocol ]] && command -v whiptail >/dev/null 2>&1; then
    protocol=$(whiptail --title "RIZAY - GOST protocol" --menu "Rule protocol" 13 54 2 \
      tcp "TCP" udp "UDP" 3>&1 1>&2 2>&3) || die "cancelled"
  fi
  [[ -n $protocol ]] || read -r -p "Protocol (tcp/udp): " protocol
  [[ -n $source_port ]] || source_port=$(ui_input "RIZAY - Remove GOST" "IRAN listener port to remove:" "")
  valid_protocol "$protocol" || die "protocol must be tcp or udp"
  valid_port "$source_port" || die "IRAN port must be 1-65535"
  [[ -s $GOST_RULES_FILE ]] || die "no saved GOST rules"
  acquire_lock
  if ! awk -v p="$protocol" -v s="$source_port" \
    '$1 == p && $2 == s { found=1 } END { exit !found }' "$GOST_RULES_FILE"; then
    die "GOST rule not found: $protocol/$source_port"
  fi
  tmp=$(mktemp "$CONFIG_DIR/gost-rules.XXXXXX")
  awk -v p="$protocol" -v s="$source_port" '!($1 == p && $2 == s)' "$GOST_RULES_FILE" > "$tmp"
  chmod 600 "$tmp"
  if [[ -s $tmp ]]; then mv -f "$tmp" "$GOST_RULES_FILE"; else rm -f -- "$tmp" "$GOST_RULES_FILE"; fi
  sync_gost
  ui_message "RIZAY - GOST rule removed" "$protocol/$source_port was removed and the GOST service was rebuilt."
}


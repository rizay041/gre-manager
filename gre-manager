      1|2|9|0) ;;
      *) if [[ ! -r $CONFIG_FILE ]]; then
           ui_message "RIZAY - Setup first" "Choose 1) IRAN or 2) KHAREJ to configure this server first."
           continue
         fi ;;
    esac
    case "$choice" in

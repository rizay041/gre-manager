[Unit]
Description=RIZAY Tunnel Manager - GOST forwarding engine
Wants=network-online.target
After=network-online.target gre-manager.service rizay-private.service
ConditionPathExists=/etc/gre-manager/gost.json

[Service]
Type=simple
ExecStart=/usr/local/lib/gre-manager/gost -C /etc/gre-manager/gost.json
Restart=on-failure
RestartSec=3s
LimitNOFILE=65536
TimeoutStartSec=30s
TimeoutStopSec=20s
UMask=0077
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
NoNewPrivileges=true
LockPersonality=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
